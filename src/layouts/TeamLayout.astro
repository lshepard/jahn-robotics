---
import BaseLayout from './BaseLayout.astro';

interface Props {
  name: string;
  number: number;
  season: string;
  seasonYear: string;
  color: string;
  award?: string;
  awardEvent?: string;
  logo?: string;
  coaches: string[];
  members?: { name: string; reflection?: string }[];
  previousTeam?: string;
  nextTeam?: string;
}

const {
  name, number, season, seasonYear, color, award, awardEvent,
  logo, coaches, members, previousTeam, nextTeam
} = Astro.props;

const seasonDisplay = season.charAt(0).toUpperCase() + season.slice(1);

// Build lineage links + season data
import { getCollection } from 'astro:content';
const allTeams = await getCollection('teams');
const allSeasons = await getCollection('seasons');
const seasonData = allSeasons.find(s => s.data.slug === season);
const seasonLogo = seasonData?.data.logo;

let prevTeamData = null;
let nextTeamData = null;

if (previousTeam) {
  const [prevSeason, prevSlug] = previousTeam.split('/');
  prevTeamData = allTeams.find(t => t.data.season === prevSeason && t.data.slug === prevSlug);
}
if (nextTeam) {
  const [nextSeason, nextSlug] = nextTeam.split('/');
  nextTeamData = allTeams.find(t => t.data.season === nextSeason && t.data.slug === nextSlug);
}

const reflections = members?.filter(m => m.reflection && m.reflection.trim() !== '') || [];
---

<BaseLayout title={name} description={`${name} - Team #${number} | Jahn Robotics FIRST LEGO League ${seasonDisplay} ${seasonYear}`}>
  <!-- Team header -->
  <section class="pt-24 sm:pt-28 pb-12 sm:pb-16" style={`background: linear-gradient(135deg, ${color}15, ${color}05)`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/teams/" class="hover:text-electric transition-colors">Teams</a>
        <span>/</span>
        <span class="text-gray-600">{seasonDisplay} {seasonYear}</span>
        <span>/</span>
        <span class="text-gray-900 font-medium">{name}</span>
      </nav>

      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
        {logo && (
          <div
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden bg-white shadow-lg flex items-center justify-center p-2"
            style={`border: 3px solid ${color}`}
          >
            <img src={logo} alt={`${name} logo`} class="w-full h-full object-contain" />
          </div>
        )}
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-2 flex-wrap">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">{name}</h1>
            <span
              class="text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider"
              style={`background: ${color}20; color: ${color}`}
            >
              {seasonDisplay}
            </span>
          </div>
          <p class="text-gray-500 mb-3">Team #{number} &middot; {seasonYear}</p>
          {award && (
            <div class="inline-flex items-center gap-2 bg-orange/10 text-orange rounded-full px-4 py-2 text-sm font-semibold">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
              {award}{awardEvent ? ` — ${awardEvent}` : ''}
            </div>
          )}
        </div>
        {seasonLogo && (
          <img
            src={seasonLogo}
            alt={`${seasonDisplay} season`}
            class:list={[
              'hidden sm:block h-20 lg:h-24 w-auto object-contain opacity-80',
              season === 'submerged' ? 'rounded-full' : 'rounded-lg'
            ]}
          />
        )}
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Coaches -->
      <div class="mb-10">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Coaches</h2>
        <div class="flex flex-wrap gap-2">
          {coaches.map(coach => (
            <span class="bg-gray-100 text-gray-700 text-sm font-medium px-3 py-1.5 rounded-lg">
              {coach}
            </span>
          ))}
        </div>
      </div>

      <!-- Student reflections -->
      {reflections.length > 0 && (
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">From the Team</h2>
          <div class="space-y-4">
            {reflections.map(member => (
              <blockquote
                class="border-l-4 pl-6 py-4 bg-gray-50 rounded-r-xl"
                style={`border-color: ${color}`}
              >
                <p class="text-gray-700 italic leading-relaxed mb-2">"{member.reflection}"</p>
                <cite class="text-sm text-gray-500 not-italic font-medium">— {member.name}</cite>
              </blockquote>
            ))}
          </div>
        </div>
      )}

      <!-- Markdown body -->
      <div class="prose">
        <slot />
      </div>

      <!-- Season lineage -->
      {(prevTeamData || nextTeamData) && (
        <div class="mt-12 pt-8 border-t border-gray-200">
          <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Team #{number} History</h2>
          <div class="flex flex-col sm:flex-row gap-4">
            {prevTeamData && (
              <a
                href={`/teams/${prevTeamData.data.season}/${prevTeamData.data.slug}/`}
                class="flex-1 flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-electric hover:bg-electric/5 transition-all group"
              >
                <svg class="w-5 h-5 text-gray-400 group-hover:text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                <div>
                  <p class="text-xs text-gray-400">Previous Season</p>
                  <p class="font-semibold text-gray-900 group-hover:text-electric transition-colors">{prevTeamData.data.name}</p>
                  <p class="text-xs text-gray-400">{prevTeamData.data.seasonYear}</p>
                </div>
              </a>
            )}
            {nextTeamData && (
              <a
                href={`/teams/${nextTeamData.data.season}/${nextTeamData.data.slug}/`}
                class="flex-1 flex items-center justify-end gap-3 p-4 rounded-xl border border-gray-200 hover:border-electric hover:bg-electric/5 transition-all group text-right"
              >
                <div>
                  <p class="text-xs text-gray-400">Next Season</p>
                  <p class="font-semibold text-gray-900 group-hover:text-electric transition-colors">{nextTeamData.data.name}</p>
                  <p class="text-xs text-gray-400">{nextTeamData.data.seasonYear}</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            )}
          </div>
        </div>
      )}

      <!-- Back to teams -->
      <div class="mt-8">
        <a href="/teams/" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-medium transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          Back to all teams
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
