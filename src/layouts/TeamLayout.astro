---
import BaseLayout from './BaseLayout.astro';
import MediaHero from '../components/shared/MediaHero.astro';
import MediaGallery from '../components/shared/MediaGallery.astro';
import { getTeamMedia } from '../lib/media';
import { getAwardDescription } from '../lib/awards';

interface Props {
  name: string;
  number: number;
  slug: string;
  season: string;
  seasonYear: string;
  color: string;
  awards?: { name: string; event: string }[];
  advancement?: string;
  logo?: string;
  photo?: string;
  coaches: string[];
  members?: { name: string; reflection?: string }[];
  previousTeam?: string;
  nextTeam?: string;
}

const {
  name, number, slug, season, seasonYear, color, awards, advancement,
  logo, photo, coaches, members, previousTeam, nextTeam
} = Astro.props;

const teamMedia = getTeamMedia(slug);

const seasonDisplay = season.charAt(0).toUpperCase() + season.slice(1);

// Build lineage links + season data
import { getCollection } from 'astro:content';
const allTeams = await getCollection('teams');
const allSeasons = await getCollection('seasons');
const seasonData = allSeasons.find(s => s.data.slug === season);
const seasonLogo = seasonData?.data.logo;

let prevTeamData = null;
let nextTeamData = null;

if (previousTeam) {
  const [prevSeason, prevSlug] = previousTeam.split('/');
  prevTeamData = allTeams.find(t => t.data.season === prevSeason && t.data.slug === prevSlug);
}
if (nextTeam) {
  const [nextSeason, nextSlug] = nextTeam.split('/');
  nextTeamData = allTeams.find(t => t.data.season === nextSeason && t.data.slug === nextSlug);
}

const reflections = members?.filter(m => m.reflection && m.reflection.trim() !== '') || [];
---

<BaseLayout title={name} description={`${name} - Team #${number} | Jahn Robotics FIRST LEGO League ${seasonDisplay} ${seasonYear}`}>
  <!-- Breadcrumb bar -->
  <section class="pt-24 sm:pt-28 pb-4" style={`background: linear-gradient(135deg, ${color}15, ${color}05)`}>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-sm text-gray-400">
        <a href="/teams/" class="hover:text-electric transition-colors">Teams</a>
        <span>/</span>
        <span class="text-gray-600">{seasonDisplay} {seasonYear}</span>
        <span>/</span>
        <span class="text-gray-900 font-medium">{name}</span>
      </nav>
    </div>
  </section>

  <!-- Team hero with media montage or photo background -->
  {(teamMedia.length > 0 || photo) ? (
    <section class="relative overflow-hidden">
      {teamMedia.length > 0 ? (
        <MediaHero
          media={teamMedia}
          fallbackImage={photo}
          overlayClass="bg-gradient-to-t from-black/60 via-black/25 to-black/10"
        />
      ) : (
        <Fragment>
          <div
            class="absolute inset-0 bg-cover bg-top"
            style={`background-image: url('${photo}');`}
          ></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/25 to-black/10"></div>
        </Fragment>
      )}
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
        <div class="flex flex-col sm:flex-row items-start sm:items-end gap-6">
          {logo && (
            <div
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl overflow-hidden bg-white/90 backdrop-blur-sm shadow-lg flex items-center justify-center p-2"
              style={`border: 3px solid ${color}`}
            >
              <img src={logo} alt={`${name} logo`} class="w-full h-full object-contain" />
            </div>
          )}
          <div class="flex-1">
            <h1 class="text-3xl sm:text-4xl font-bold text-white drop-shadow-md mb-2">{name}</h1>
            <div class="flex items-center gap-3 flex-wrap">
              <span class="bg-white/20 backdrop-blur-sm text-white text-sm font-medium px-3 py-1 rounded-full">
                {seasonDisplay} · {seasonYear}
              </span>
              <span class="text-white/70 text-sm font-medium">#{number}</span>
            </div>
          </div>
          {seasonLogo && (
            <img
              src={seasonLogo}
              alt={`${seasonDisplay} season`}
              class:list={[
                'hidden sm:block h-16 lg:h-20 w-auto object-contain opacity-70',
                season === 'submerged' ? 'rounded-full' : 'rounded-lg'
              ]}
            />
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="pb-12 sm:pb-16" style={`background: linear-gradient(135deg, ${color}15, ${color}05)`}>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 pt-6">
          {logo && (
            <div
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl overflow-hidden bg-white shadow-lg flex items-center justify-center p-2"
              style={`border: 3px solid ${color}`}
            >
              <img src={logo} alt={`${name} logo`} class="w-full h-full object-contain" />
            </div>
          )}
          <div class="flex-1">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">{name}</h1>
            <div class="flex items-center gap-3 flex-wrap">
              <span class="bg-gray-200 text-gray-700 text-sm font-medium px-3 py-1 rounded-full">
                {seasonDisplay} · {seasonYear}
              </span>
              <span class="text-gray-500 text-sm font-medium">#{number}</span>
            </div>
          </div>
          {seasonLogo && (
            <img
              src={seasonLogo}
              alt={`${seasonDisplay} season`}
              class:list={[
                'hidden sm:block h-20 lg:h-24 w-auto object-contain opacity-80',
                season === 'submerged' ? 'rounded-full' : 'rounded-lg'
              ]}
            />
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Awards & Advancement section -->
  {(awards && awards.length > 0) || advancement ? (
    <section class="py-12 sm:py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
        {/* Awards first */}
        {awards && awards.map(award => {
          const description = getAwardDescription(award.name);
          return (
            <div class="bg-white rounded-xl p-5 flex items-center gap-5 shadow-sm border border-gray-100">
              <div class="w-20 h-20 rounded-xl bg-amber-50 flex items-center justify-center flex-shrink-0">
                <img src="/images/fll/trophy.png" alt="Trophy" class="w-16 h-16 object-contain" />
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-gray-900 text-lg">{award.name}</p>
                <p class="font-semibold text-orange">{award.event}</p>
                {description && <p class="text-gray-500 text-sm">{description}</p>}
              </div>
            </div>
          );
        })}
        {/* Advancement last */}
        {advancement && (
          <div class="bg-white rounded-xl p-5 flex items-center gap-5 shadow-sm border border-gray-100">
            <div class="w-20 h-20 rounded-xl bg-sky-50 flex items-center justify-center flex-shrink-0">
              <img src="/images/fll/illinois.png" alt="Illinois" class="w-16 h-16 object-contain" />
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-bold text-gray-900 text-lg">Advanced to {advancement}</p>
              <p class="font-semibold text-electric">{advancement === 'State' ? 'State' : 'Sectionals'}</p>
              <p class="text-gray-500 text-sm">{advancement === 'State' ? 'Illinois State Championship' : 'Sectional Championship'}</p>
            </div>
          </div>
        )}
      </div>
    </section>
  ) : null}

  <!-- Media gallery -->
  {teamMedia.length > 0 && (
    <MediaGallery media={teamMedia} color={color} />
  )}

  <!-- Main content -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Coaches -->
      <div class="mb-10">
        <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Coaches</h2>
        <div class="flex flex-wrap gap-2">
          {coaches.map(coach => (
            <span class="bg-gray-100 text-gray-700 text-sm font-medium px-3 py-1.5 rounded-lg">
              {coach}
            </span>
          ))}
        </div>
      </div>

      <!-- Student reflections -->
      {reflections.length > 0 && (
        <div class="mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">From the Team</h2>
          <div class="space-y-4">
            {reflections.map(member => (
              <blockquote
                class="border-l-4 pl-6 py-4 bg-gray-50 rounded-r-xl"
                style={`border-color: ${color}`}
              >
                <p class="text-gray-700 italic leading-relaxed mb-2">"{member.reflection}"</p>
                <cite class="text-sm text-gray-500 not-italic font-medium">— {member.name}</cite>
              </blockquote>
            ))}
          </div>
        </div>
      )}

      <!-- Markdown body -->
      <div class="prose">
        <slot />
      </div>

      <!-- Season lineage -->
      {(prevTeamData || nextTeamData) && (
        <div class="mt-12 pt-8 border-t border-gray-200">
          <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Team #{number} History</h2>
          <div class="flex flex-col sm:flex-row gap-4">
            {prevTeamData && (
              <a
                href={`/teams/${prevTeamData.data.season}/${prevTeamData.data.slug}/`}
                class="flex-1 flex items-center gap-3 p-4 rounded-xl border border-gray-200 hover:border-electric hover:bg-electric/5 transition-all group"
              >
                <svg class="w-5 h-5 text-gray-400 group-hover:text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
                </svg>
                <div>
                  <p class="text-xs text-gray-400">Previous Season</p>
                  <p class="font-semibold text-gray-900 group-hover:text-electric transition-colors">{prevTeamData.data.name}</p>
                  <p class="text-xs text-gray-400">{prevTeamData.data.seasonYear}</p>
                </div>
              </a>
            )}
            {nextTeamData && (
              <a
                href={`/teams/${nextTeamData.data.season}/${nextTeamData.data.slug}/`}
                class="flex-1 flex items-center justify-end gap-3 p-4 rounded-xl border border-gray-200 hover:border-electric hover:bg-electric/5 transition-all group text-right"
              >
                <div>
                  <p class="text-xs text-gray-400">Next Season</p>
                  <p class="font-semibold text-gray-900 group-hover:text-electric transition-colors">{nextTeamData.data.name}</p>
                  <p class="text-xs text-gray-400">{nextTeamData.data.seasonYear}</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            )}
          </div>
        </div>
      )}

      <!-- Back to teams -->
      <div class="mt-8">
        <a href="/teams/" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-medium transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          Back to all teams
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
