---
import { getCollection } from 'astro:content';

const allTeams = await getCollection('teams');
const currentTeams = allTeams
  .filter(t => t.data.season === 'unearthed')
  .sort((a, b) => a.data.number - b.data.number);

const teamColorMap: Record<string, string> = {
  '#F59E0B': 'from-amber-500 to-amber-600',
  '#8B5CF6': 'from-violet-500 to-violet-600',
  '#EF4444': 'from-red-500 to-red-600',
  '#14B8A6': 'from-teal-500 to-teal-600',
};

const teamBorderMap: Record<string, string> = {
  '#F59E0B': 'border-amber-400',
  '#8B5CF6': 'border-violet-400',
  '#EF4444': 'border-red-400',
  '#14B8A6': 'border-teal-400',
};
---

<section class="py-16 sm:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 animate-on-scroll">
      <span class="inline-block bg-electric/10 text-electric text-sm font-semibold px-4 py-1.5 rounded-full mb-4 uppercase tracking-wider">
        2025-26 Season
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        UNEARTHED
      </h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        Four teams tackling the archaeology challenge, uncovering the past to discover the future.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {currentTeams.map((team, i) => (
        <a
          href={`/teams/${team.data.season}/${team.data.slug}/`}
          class={`group card-hover rounded-2xl overflow-hidden bg-white border-2 ${teamBorderMap[team.data.color] || 'border-gray-200'} animate-on-scroll stagger-${i + 1}`}
        >
          <!-- Color header -->
          <div class={`h-2 bg-gradient-to-r ${teamColorMap[team.data.color] || 'from-gray-400 to-gray-500'}`}></div>

          <div class="p-6">
            {/* Team logo */}
            {team.data.logo && (
              <div class="w-20 h-20 mx-auto mb-4 rounded-xl overflow-hidden bg-gray-100 flex items-center justify-center">
                <img
                  src={team.data.logo}
                  alt={`${team.data.name} logo`}
                  class="w-full h-full object-contain p-1"
                />
              </div>
            )}

            <h3 class="text-lg font-bold text-gray-900 text-center mb-1 group-hover:text-electric transition-colors">
              {team.data.name}
            </h3>
            <p class="text-sm text-gray-400 text-center mb-3">#{team.data.number}</p>

            {team.data.tagline && (
              <p class="text-sm text-gray-500 text-center mb-4 italic">
                {team.data.tagline}
              </p>
            )}

            {team.data.award && (
              <div class="flex items-center justify-center gap-1.5 bg-orange/10 text-orange rounded-full px-3 py-1.5 text-xs font-semibold">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                {team.data.award}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

    <div class="text-center mt-10 animate-on-scroll">
      <a href="/teams/" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-semibold transition-colors">
        View all seasons & teams
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>
