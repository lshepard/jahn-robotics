---
import MediaHero from '../shared/MediaHero.astro';
import { getCurrentYearMedia } from '../../lib/media';

const allMedia = getCurrentYearMedia();
---

<section class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
  <!-- Video/photo background montage -->
  <MediaHero
    media={allMedia}
    fallbackImage="/images/hero-poster.jpg"
    overlayClass="bg-gradient-to-b from-navy/70 via-navy/50 to-navy/90"
  />

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
    <div class="animate-on-scroll">
      <p class="text-sm sm:text-base font-semibold text-electric uppercase tracking-widest mb-4">Jahn Robotics</p>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-6 leading-tight tracking-tight">
        Award-Winning
        <span class="text-electric"> Robotics Program</span>
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-white/80 mb-8 max-w-2xl mx-auto leading-relaxed">
        Two teams qualified for State. Indiana Drones won the Motivate Award! An incredible season at <a href="https://www.jahnschool.com" target="_blank" rel="noopener noreferrer" class="underline decoration-white/40 hover:decoration-white transition-colors">Jahn Elementary</a>.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/teams/"
          class="inline-flex items-center gap-2 bg-orange hover:bg-orange-dark text-white font-semibold px-8 py-4 rounded-xl text-lg transition-all hover:scale-105 shadow-lg shadow-orange/25"
        >
          Meet Our Teams
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href="/about/"
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-xl text-lg transition-all backdrop-blur-sm border border-white/20"
        >
          About Our Program
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>
