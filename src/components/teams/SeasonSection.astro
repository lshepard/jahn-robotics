---
interface TeamData {
  id: string;
  data: {
    name: string;
    number: number;
    slug: string;
    season: string;
    seasonYear: string;
    color: string;
    award?: string;
    awardEvent?: string;
    logo?: string;
    tagline?: string;
    previousTeam?: string;
    nextTeam?: string;
  };
}

interface Props {
  seasonName: string;
  seasonSlug: string;
  seasonYear: string;
  fllTheme: string;
  seasonLogo?: string;
  seasonBackground?: string;
  teams: TeamData[];
  isCurrent?: boolean;
}

const { seasonName, seasonSlug, seasonYear, fllTheme, seasonLogo, seasonBackground, teams, isCurrent = false } = Astro.props;

const cardClass = `season-card-${seasonSlug}`;

const teamColorMap: Record<string, string> = {
  '#F59E0B': 'from-amber-500 to-amber-600',
  '#8B5CF6': 'from-violet-500 to-violet-600',
  '#EF4444': 'from-red-500 to-red-600',
  '#14B8A6': 'from-teal-500 to-teal-600',
  '#0EA5E9': 'from-sky-500 to-sky-600',
};

const teamBorderMap: Record<string, string> = {
  '#F59E0B': 'border-amber-400',
  '#8B5CF6': 'border-violet-400',
  '#EF4444': 'border-red-400',
  '#14B8A6': 'border-teal-400',
  '#0EA5E9': 'border-sky-400',
};
---

<section class="relative overflow-hidden mb-0">
  <!-- Background image -->
  {seasonBackground && (
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${seasonBackground}');`}
    ></div>
  )}
  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-black/50"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <!-- Season header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 mb-10 animate-on-scroll">
      {seasonLogo && (
        <img
          src={seasonLogo}
          alt={`${seasonName} season logo`}
          class:list={[
            'h-16 sm:h-20 w-auto object-contain',
            seasonSlug === 'submerged' ? 'rounded-full' : 'rounded-lg'
          ]}
        />
      )}
      <div>
        <div class="flex items-center gap-3 mb-1">
          <h2 class="text-2xl sm:text-3xl font-bold text-white drop-shadow-md">{seasonName}</h2>
          {isCurrent && (
            <span class="bg-white/20 text-white text-xs font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider backdrop-blur-sm">
              Current
            </span>
          )}
        </div>
        <p class="text-white/80 drop-shadow-sm">
          {seasonYear} &middot; {fllTheme} &middot; {teams.length} {teams.length === 1 ? 'team' : 'teams'}
        </p>
      </div>
    </div>

    <!-- Team cards grid -->
    <div class:list={[
      'grid gap-6',
      teams.length === 1 ? 'grid-cols-1 max-w-sm' :
      teams.length === 2 ? 'grid-cols-1 sm:grid-cols-2 max-w-2xl' :
      'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
    ]}>
      {teams.map((team, i) => (
        <a
          href={`/teams/${team.data.season}/${team.data.slug}/`}
          class={`group card-hover rounded-2xl overflow-hidden border-2 bg-white/90 backdrop-blur-sm ${teamBorderMap[team.data.color] || 'border-gray-200'} animate-on-scroll stagger-${i + 1}`}
        >
          <div class={`h-2 bg-gradient-to-r ${teamColorMap[team.data.color] || 'from-gray-400 to-gray-500'}`}></div>
          <div class="p-6">
            {team.data.logo && (
              <div class="w-16 h-16 mx-auto mb-3 rounded-xl overflow-hidden bg-gray-100 flex items-center justify-center">
                <img src={team.data.logo} alt={`${team.data.name} logo`} class="w-full h-full object-contain p-1" />
              </div>
            )}
            <h3 class="text-lg font-bold text-gray-900 text-center mb-1 group-hover:text-electric transition-colors">
              {team.data.name}
            </h3>
            <p class="text-sm text-gray-400 text-center mb-3">#{team.data.number}</p>
            {team.data.award && (
              <div class="flex items-center justify-center gap-1.5 bg-orange/10 text-orange rounded-full px-3 py-1.5 text-xs font-semibold">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
                {team.data.award}
              </div>
            )}
            {team.data.nextTeam && (
              <p class="text-xs text-gray-400 text-center mt-3">
                Continued as next season's team &rarr;
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
