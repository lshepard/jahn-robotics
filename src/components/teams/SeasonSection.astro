---
interface TeamData {
  id: string;
  data: {
    name: string;
    number: number;
    slug: string;
    season: string;
    seasonYear: string;
    color: string;
    awards?: { name: string; event: string }[];
    advancement?: string;
    logo?: string;
    tagline?: string;
    previousTeam?: string;
    nextTeam?: string;
  };
}

interface Props {
  seasonName: string;
  seasonSlug: string;
  seasonYear: string;
  fllTheme: string;
  seasonLogo?: string;
  seasonBackground?: string;
  teams: TeamData[];
  isCurrent?: boolean;
}

const { seasonName, seasonSlug, seasonYear, fllTheme, seasonLogo, seasonBackground, teams, isCurrent = false } = Astro.props;

function darken(hex: string, amount: number): string {
  const num = parseInt(hex.replace('#', ''), 16);
  const r = Math.max(0, (num >> 16) - amount);
  const g = Math.max(0, ((num >> 8) & 0x00FF) - amount);
  const b = Math.max(0, (num & 0x0000FF) - amount);
  return `#${(r << 16 | g << 8 | b).toString(16).padStart(6, '0')}`;
}
---

<section class="relative overflow-hidden mb-0">
  <!-- Background image -->
  {seasonBackground && (
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url('${seasonBackground}');`}
    ></div>
  )}
  <!-- Dark overlay for readability -->
  <div class="absolute inset-0 bg-black/50"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20">
    <!-- Season header -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 mb-10 animate-on-scroll">
      {seasonLogo && (
        <img
          src={seasonLogo}
          alt={`${seasonName} season logo`}
          class:list={[
            'h-16 sm:h-20 w-auto object-contain',
            seasonSlug === 'submerged' ? 'rounded-full' : 'rounded-lg'
          ]}
        />
      )}
      <div>
        <div class="flex items-center gap-3 mb-1">
          <h2 class="text-2xl sm:text-3xl font-bold text-white drop-shadow-md">{seasonName}</h2>
        </div>
        <p class="text-white/80 drop-shadow-sm">
          {seasonYear} &middot; {fllTheme} &middot; {teams.length} {teams.length === 1 ? 'team' : 'teams'}
        </p>
      </div>
    </div>

    <!-- Team cards grid -->
    <div class:list={[
      'grid gap-8',
      teams.length === 1 ? 'grid-cols-1 max-w-xs' :
      teams.length === 2 ? 'grid-cols-1 sm:grid-cols-2 max-w-2xl' :
      'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4'
    ]}>
      {teams.map((team, i) => (
        <div class={`relative pt-5 animate-on-scroll stagger-${i + 1}`}>
          {/* Trophies for award winners */}
          {team.data.awards && team.data.awards.length > 0 && (
            <div class="absolute -top-2 right-4 z-20 flex flex-row gap-2">
              {team.data.awards.map((award) => (
                <div class="flex flex-col items-center w-16">
                  <img src="/images/fll/trophy.png" alt="Trophy" class="w-10 h-auto drop-shadow-lg" />
                  <span class="text-[9px] font-bold text-orange bg-white/90 backdrop-blur-sm rounded px-1.5 py-0.5 mt-1 shadow-sm text-center leading-tight">
                    {award.name}
                  </span>
                </div>
              ))}
            </div>
          )}
          <a
            href={`/teams/${team.data.season}/${team.data.slug}/`}
            class="group card-hover block rounded-2xl overflow-hidden border-2 relative"
            style={`border-color: ${team.data.color}80;`}
          >
            {/* Logo as full card background */}
            <div class="relative aspect-[4/3] bg-white flex items-center justify-center overflow-hidden">
              {team.data.logo ? (
                <img
                  src={team.data.logo}
                  alt={`${team.data.name} logo`}
                  class="w-3/4 h-3/4 object-contain opacity-90 group-hover:scale-105 transition-transform duration-300"
                />
              ) : (
                <div
                  class="w-20 h-20 rounded-full opacity-20"
                  style={`background: ${team.data.color};`}
                ></div>
              )}
            </div>
            {/* Team name bar */}
            <div
              class="px-4 py-3"
              style={`background: linear-gradient(135deg, ${team.data.color}, ${darken(team.data.color, 30)});`}
            >
              <h3 class="text-white font-bold text-center text-sm sm:text-base drop-shadow-sm group-hover:tracking-wide transition-all">
                {team.data.name}
              </h3>
            </div>
          </a>
          {/* Advancement badge */}
          {team.data.advancement && (
            <div class="flex justify-center mt-2">
              <span class={`text-xs font-semibold px-3 py-1 rounded-full ${team.data.advancement === 'State' ? 'bg-electric text-white' : 'bg-gray-200 text-gray-700'}`}>
                Advanced to {team.data.advancement}
              </span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
