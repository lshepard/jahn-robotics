---
import BaseLayout from '../layouts/BaseLayout.astro';

const volunteers = [
  { name: 'Luke Shepard', role: 'Lead Coach', image: '/images/coaches/luke.png' },
  { name: 'Mollie Rapp', role: 'Coach', image: '/images/coaches/mollie.png' },
  { name: 'Johnny Vivoda', role: 'Coach', image: '/images/coaches/johnny.png' },
  { name: 'Jeff Shepard', role: 'Coach', image: '/images/coaches/jeff.png' },
  { name: 'Colleen Lavin', role: 'Coach', image: '/images/coaches/colleen.png' },
  { name: 'Sandra Sugano', role: 'Coach', image: '/images/coaches/sandra.png' },
  { name: 'Jake Rapp', role: 'Coach', image: '/images/coaches/jake.png' },
  { name: 'Emily Brown', role: 'Coach', image: '/images/coaches/emily.png' },
  { name: 'Paul Baker', role: 'Coach', image: '/images/coaches/paul.png' },
  { name: 'Tamer Haddadin', role: 'Coach', image: '/images/coaches/tamer.png' },
];
---

<BaseLayout title="Volunteers" description="Meet the dedicated volunteers who make Jahn Robotics possible.">
  <!-- Hero Section -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Our Volunteers
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Meet the dedicated team that makes Jahn Robotics possible
      </p>
    </div>
  </section>

  <!-- We Need Volunteers CTA -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-electric rounded-2xl p-8 sm:p-10 text-center animate-on-scroll">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">We Need Volunteers!</h2>
        <p class="text-white/90 mb-6 max-w-2xl mx-auto text-lg">
          Jahn Robotics runs entirely on parent and community volunteers. Whether you have a background
          in STEM or just want to help kids learn and grow, there's a place for you on our team.
          No experience necessary — just enthusiasm and a willingness to learn alongside the students.
        </p>
        <a
          href="https://www.jahnschool.com/apps/pages/Volunteer"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white hover:bg-gray-100 text-electric font-semibold px-6 py-3 rounded-xl transition-all"
        >
          Get Involved
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Volunteers Grid -->
  <section class="py-16 sm:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 sm:gap-8">
        {volunteers.map((volunteer, index) => (
          <div class={`text-center animate-on-scroll stagger-${(index % 4) + 1}`}>
            <div class="aspect-square rounded-2xl overflow-hidden bg-gray-100 mb-4 shadow-lg">
              <img
                src={volunteer.image}
                alt={volunteer.name}
                class="w-full h-full object-cover brightness-125"
                loading="lazy"
              />
            </div>
            <h3 class="font-bold text-gray-900 text-lg">{volunteer.name}</h3>
            <p class={`text-sm font-medium ${volunteer.role === 'Lead Coach' ? 'text-electric' : 'text-gray-500'}`}>
              {volunteer.role}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
