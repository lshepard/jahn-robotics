---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Advanced Robotics" description="Python programming with XRP robots - Spring 2026 class for grades 5-7">
  <!-- Header -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block bg-electric/20 text-electric font-semibold text-sm px-4 py-2 rounded-full mb-6">
        Wednesdays · 3:30–4:30pm
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 animate-on-scroll">
        Advanced Robotics
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Grades 5th–7th · Spring 2026
      </p>
    </div>
  </section>

  <!-- Overview -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 shadow-lg">
        <h2 class="text-2xl font-bold text-navy mb-4">About This Class</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Go beyond LEGO to learn more advanced programming and build techniques. Students will work 
          in small groups using <strong>Python</strong> to solve challenges with <strong>XRP robots</strong> — 
          a platform designed as a bridge to high-school level robotics.
        </p>
        <p class="text-gray-700 leading-relaxed mb-4">
          This class is ideal for students who have already participated in an FLL team or have some 
          coding experience. We'll tackle real engineering challenges in our <strong>Robot Olympics</strong> 
          themed curriculum!
        </p>
        <a 
          href="https://experientialrobotics.org/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-semibold transition-colors"
        >
          Learn more about XRP
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Details Grid -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Schedule -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-electric/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-navy">Schedule</h3>
          </div>
          <ul class="space-y-2 text-gray-700">
            <li><strong>When:</strong> Every Wednesday, 3:30–4:30pm</li>
            <li><strong>Where:</strong> Mr. Albo's Classroom</li>
            <li><strong>Dates:</strong> February 25 – May 6, 2026</li>
            <li class="text-gray-500 text-sm italic">Spring Break: March 18 (no class)</li>
          </ul>
        </div>

        <!-- Who -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-electric/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-navy">Who</h3>
          </div>
          <ul class="space-y-2 text-gray-700">
            <li><strong>Grades:</strong> 5th–7th</li>
            <li><strong>Experience:</strong> Some coding or FLL experience helpful</li>
            <li><strong>Instructors:</strong> Luke Shepard, Mr. Albo</li>
            <li><strong>Volunteer Coaches:</strong> Parent volunteers</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- What We're Learning -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">What We're Learning</h2>
      
      <div class="grid gap-6 md:grid-cols-3">
        <!-- Python -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-14 h-14 bg-navy text-white rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="font-bold text-navy mb-2">Python Programming</h3>
          <p class="text-gray-600 text-sm">Learn real programming with Python — the language used by professional developers and data scientists.</p>
        </div>

        <!-- XRP -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-14 h-14 bg-electric text-white rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
          </div>
          <h3 class="font-bold text-navy mb-2">XRP Robots</h3>
          <p class="text-gray-600 text-sm">Build and program XRP robots — a platform that bridges elementary robotics to high school competitions.</p>
        </div>

        <!-- Challenges -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center">
          <div class="w-14 h-14 bg-yellow-500 text-white rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
            </svg>
          </div>
          <h3 class="font-bold text-navy mb-2">Robot Olympics</h3>
          <p class="text-gray-600 text-sm">Compete in challenges inspired by Olympic events — racing, precision tasks, and teamwork competitions.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Date -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">Key Date for Parents</h2>
      
      <div class="max-w-md mx-auto">
        <div class="bg-gradient-to-br from-navy to-navy-dark rounded-2xl p-8 text-white text-center">
          <div class="text-sm font-medium opacity-80 mb-2">Final Showcase</div>
          <div class="text-4xl font-bold mb-3">May 6</div>
          <p class="opacity-90">Join us for the Robot Olympics finale! Watch your students demonstrate their robots and explain their programming.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Back Link -->
  <section class="py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/classes" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to All Classes
      </a>
    </div>
  </section>
</BaseLayout>
