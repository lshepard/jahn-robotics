---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mission Solutions" description="Video tutorials and inspiration for FLL mission challenges">
  <!-- Header -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block bg-electric/20 text-electric font-semibold text-sm px-4 py-2 rounded-full mb-6">
        Student Resources
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 animate-on-scroll">
        Mission Solutions
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Watch for inspiration, then design YOUR own solutions!
      </p>
    </div>
  </section>

  <!-- Important Note -->
  <section class="py-8 bg-amber-50 border-b border-amber-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 bg-amber-100 rounded-xl flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-amber-800 mb-1">Remember the 3 Ways Rule!</h3>
          <p class="text-amber-700">
            Watch these videos for <strong>ideas</strong>, not to copy. Design your OWN 3 different solutions before picking one!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Submerged Section -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-4xl">🌊</span>
        <div>
          <h2 class="text-2xl font-bold text-navy">FLL SUBMERGED</h2>
          <p class="text-gray-500">2024-25 Season</p>
        </div>
      </div>

      <!-- Best Resource -->
      <div class="bg-gradient-to-br from-electric to-electric-dark rounded-2xl p-6 mb-8 text-white">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="font-semibold">Best Resource</span>
        </div>
        <h3 class="text-xl font-bold mb-2">Team 4924 Red Beard Pandas</h3>
        <p class="opacity-90 mb-4">Simple solutions for ALL missions with code screenshots. Great for beginners!</p>
        <a href="https://www.tuxedopandas.org/Outreach/fll-submerged-2024-25" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg font-medium transition-colors">
          View All Solutions
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Mission Videos -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="p-6 border-b border-gray-100">
          <h3 class="font-bold text-navy">Video Solutions by Mission</h3>
        </div>
        <div class="divide-y divide-gray-100">
          <a href="https://www.youtube.com/watch?v=-zCvxOW1tUs" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-navy text-white rounded-lg flex items-center justify-center text-sm font-bold">02</span>
              <span class="font-medium text-gray-900">Shark</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/watch?v=OzX-Y10U9dA" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-navy text-white rounded-lg flex items-center justify-center text-sm font-bold">02</span>
              <span class="font-medium text-gray-900">Shark (Ultimate Guide)</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/playlist?list=PLrxSaAUCcYu7Fdg1AvTcl_5zuhCsg3rrY" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-electric text-white rounded-lg flex items-center justify-center text-sm font-bold">ALL</span>
              <span class="font-medium text-gray-900">Tech Warriors Playlist (All Missions)</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Unearthed Section -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-8">
        <span class="text-4xl">⛏️</span>
        <div>
          <h2 class="text-2xl font-bold text-navy">FLL UNEARTHED</h2>
          <p class="text-gray-500">2025-26 Season</p>
        </div>
      </div>

      <!-- Best Resource -->
      <div class="bg-gradient-to-br from-amber-500 to-amber-600 rounded-2xl p-6 mb-8 text-white">
        <div class="flex items-center gap-2 mb-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="font-semibold">Best Resource</span>
        </div>
        <h3 class="text-xl font-bold mb-2">All Missions Solved — Simple Robot</h3>
        <p class="opacity-90 mb-4">Uses ONLY base SPIKE Prime set. Solves every mission!</p>
        <a href="https://www.youtube.com/watch?v=EeyWueNOUAg" target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-white/20 hover:bg-white/30 px-4 py-2 rounded-lg font-medium transition-colors">
          Watch Full Video
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </a>
      </div>

      <!-- Mission Videos -->
      <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <div class="p-6 border-b border-gray-100">
          <h3 class="font-bold text-navy">Video Solutions by Mission</h3>
        </div>
        <div class="divide-y divide-gray-100">
          <a href="https://www.youtube.com/watch?v=rw1TWlJxgmU" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-navy text-white rounded-lg flex items-center justify-center text-sm font-bold">02</span>
              <span class="font-medium text-gray-900">Map Reveal</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/watch?v=y6RxJpgBOQM" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-navy text-white rounded-lg flex items-center justify-center text-sm font-bold">03</span>
              <span class="font-medium text-gray-900">Mineshaft Explorer</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/watch?v=1yyh08hg398" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-navy text-white rounded-lg flex items-center justify-center text-sm font-bold">13</span>
              <span class="font-medium text-gray-900">Statue Rebuild</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/playlist?list=PLftVV0M_ZZIsjcvgb5OI_wmgmt9b10iit" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-electric text-white rounded-lg flex items-center justify-center text-sm font-bold">ALL</span>
              <span class="font-medium text-gray-900">Tech Warriors Playlist (All Missions)</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
          <a href="https://www.youtube.com/watch?v=dYJuZzPJmco" target="_blank" rel="noopener" class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 bg-green-600 text-white rounded-lg flex items-center justify-center text-sm font-bold">545</span>
              <span class="font-medium text-gray-900">Archy Robot — Max Points Run</span>
            </div>
            <svg class="w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Tips Section -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">Tips for Students</h2>
      
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">👀</span>
            <h3 class="font-bold text-navy">Watch for IDEAS</h3>
          </div>
          <p class="text-gray-600 text-sm">Don't copy — use videos as inspiration for your own designs.</p>
        </div>
        
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">✏️</span>
            <h3 class="font-bold text-navy">Pause and Sketch</h3>
          </div>
          <p class="text-gray-600 text-sm">Draw what you see before building. It helps you understand.</p>
        </div>
        
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">🔧</span>
            <h3 class="font-bold text-navy">Notice the Attachment</h3>
          </div>
          <p class="text-gray-600 text-sm">How did they grab, push, or flip it? That's the key!</p>
        </div>
        
        <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-2xl">🎯</span>
            <h3 class="font-bold text-navy">Try YOUR Idea First</h3>
          </div>
          <p class="text-gray-600 text-sm">Build your solution, then compare to the video.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- More Resources -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">More Resources</h2>
      
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="https://flltutorials.com" target="_blank" rel="noopener" class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:border-electric hover:shadow-md transition-all text-center">
          <h3 class="font-bold text-navy mb-1">FLL Tutorials</h3>
          <p class="text-gray-500 text-sm">Lessons & worksheets</p>
        </a>
        
        <a href="https://primelessons.org" target="_blank" rel="noopener" class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:border-electric hover:shadow-md transition-all text-center">
          <h3 class="font-bold text-navy mb-1">PrimeLessons</h3>
          <p class="text-gray-500 text-sm">SPIKE programming tutorials</p>
        </a>
        
        <a href="https://www.fllcasts.com" target="_blank" rel="noopener" class="bg-white rounded-xl p-5 shadow-sm border border-gray-100 hover:border-electric hover:shadow-md transition-all text-center">
          <h3 class="font-bold text-navy mb-1">FLLCasts</h3>
          <p class="text-gray-500 text-sm">Building instructions</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Back Link -->
  <section class="py-8 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/classes/intro-to-robotics" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Intro Class
      </a>
    </div>
  </section>
</BaseLayout>
