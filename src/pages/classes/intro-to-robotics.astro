---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Intro to Robotics" description="Learn robotics basics with LEGO Spike Prime - Spring 2026 class for grades 3-5">
  <!-- Header -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block bg-electric/20 text-electric font-semibold text-sm px-4 py-2 rounded-full mb-6">
        Mondays · 3:30–4:30pm
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 animate-on-scroll">
        Intro to Robotics
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Grades 3rd–5th · Spring 2026
      </p>
    </div>
  </section>

  <!-- Overview -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 shadow-lg">
        <h2 class="text-2xl font-bold text-navy mb-4">About This Class</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Learn the basics of building and programming robots using <strong>LEGO Spike Prime</strong>. 
          Students will develop engineering and problem-solving skills through hands-on projects, 
          working in pairs to build mechanisms, learn motor control, and program their robots to 
          complete challenges.
        </p>
        <p class="text-gray-600 italic">
          This is an excellent introduction for students who may be interested in joining the FLL competition team next fall!
        </p>
      </div>
    </div>
  </section>

  <!-- Details Grid -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Schedule -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-electric/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-navy">Schedule</h3>
          </div>
          <ul class="space-y-2 text-gray-700">
            <li><strong>When:</strong> Every Monday, 3:30–4:30pm</li>
            <li><strong>Where:</strong> Mr. Albo's Classroom</li>
            <li><strong>Dates:</strong> February 23 – May 4, 2026</li>
            <li class="text-gray-500 text-sm italic">Spring Break: March 23 (no class)</li>
          </ul>
        </div>

        <!-- Who -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-electric/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-navy">Who</h3>
          </div>
          <ul class="space-y-2 text-gray-700">
            <li><strong>Grades:</strong> 3rd–5th</li>
            <li><strong>Experience:</strong> No prior experience needed!</li>
            <li><strong>Lead Instructor:</strong> Luke Shepard</li>
            <li><strong>Classroom Anchor:</strong> Mr. Albo</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Curriculum -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">10-Week Curriculum</h2>
      
      <div class="space-y-4">
        <!-- Phase 1 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center font-bold shrink-0">
              1–2
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Building & Mechanisms</h3>
              <p class="text-gray-600">Learn to build different mechanisms and attachments. Explore how gears, levers, and motors work together.</p>
            </div>
          </div>
        </div>

        <!-- Phase 2 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center font-bold shrink-0">
              3–4
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Motor Control & Mini-Showcase</h3>
              <p class="text-gray-600">Learn to program motors with timing and power levels. Week 4 ends with a Mini-Showcase for parents!</p>
            </div>
          </div>
        </div>

        <!-- Phase 3 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center font-bold shrink-0">
              5–6
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Driving & Coding</h3>
              <p class="text-gray-600">Build wheeled robots and learn to program movement sequences. Navigate paths and complete challenges.</p>
            </div>
          </div>
        </div>

        <!-- Phase 4 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center font-bold shrink-0">
              7–8
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Combining Skills & Sensors</h3>
              <p class="text-gray-600">Put it all together! Add sensors for color and distance detection. Make robots that react to their environment.</p>
            </div>
          </div>
        </div>

        <!-- Phase 5 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-electric text-white rounded-xl flex items-center justify-center font-bold shrink-0">
              9–10
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Integration & Final Showcase</h3>
              <p class="text-gray-600">Pick a challenge, refine your robot, and prepare your presentation. Week 10 is the Final Showcase for families!</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Dates -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">Key Dates for Parents</h2>
      
      <div class="grid gap-6 md:grid-cols-2">
        <div class="bg-gradient-to-br from-electric to-electric-dark rounded-2xl p-6 text-white">
          <div class="text-sm font-medium opacity-80 mb-2">Mini-Showcase</div>
          <div class="text-3xl font-bold mb-2">March 16</div>
          <p class="opacity-90">Parents invited at 4:00pm to see motorized attachments in action!</p>
        </div>
        
        <div class="bg-gradient-to-br from-navy to-navy-dark rounded-2xl p-6 text-white">
          <div class="text-sm font-medium opacity-80 mb-2">Final Showcase</div>
          <div class="text-3xl font-bold mb-2">May 4</div>
          <p class="opacity-90">Final presentations to families — see everything your kids have built!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Back Link -->
  <section class="py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/classes" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to All Classes
      </a>
    </div>
  </section>
</BaseLayout>
