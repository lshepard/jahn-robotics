---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Intro to Robotics" description="Learn robotics basics with LEGO Spike Prime - Spring 2026 class for grades 3-5">
  <!-- Header -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block bg-electric/20 text-electric font-semibold text-sm px-4 py-2 rounded-full mb-6">
        Mondays · 3:30–4:30pm
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 animate-on-scroll">
        Intro to Robotics
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Grades 3rd–5th · Spring 2026
      </p>
    </div>
  </section>

  <!-- Overview -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 shadow-lg">
        <h2 class="text-2xl font-bold text-navy mb-4">About This Class</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Learn the basics of building and programming robots using <strong>LEGO Spike Prime</strong>. 
          Students will develop engineering and problem-solving skills through hands-on projects, 
          working in pairs to build mechanisms, learn motor control, and program their robots to 
          complete challenges.
        </p>
        <p class="text-gray-600 italic">
          This is an excellent introduction for students who may be interested in joining the FLL competition team next fall!
        </p>
      </div>
    </div>
  </section>

  <!-- Details Grid -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Schedule -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-electric/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-navy">Schedule</h3>
          </div>
          <ul class="space-y-2 text-gray-700">
            <li><strong>When:</strong> Every Monday, 3:30–4:30pm</li>
            <li><strong>Where:</strong> Mr. Albo's Classroom</li>
            <li><strong>Dates:</strong> February 23 – May 4, 2026</li>
            <li class="text-gray-500 text-sm italic">Spring Break: March 23 (no class)</li>
          </ul>
        </div>

        <!-- Who -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-electric/10 rounded-xl flex items-center justify-center">
              <svg class="w-5 h-5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-navy">Who</h3>
          </div>
          <ul class="space-y-2 text-gray-700">
            <li><strong>Grades:</strong> 3rd–5th</li>
            <li><strong>Experience:</strong> No prior experience needed!</li>
            <li><strong>Lead Instructor:</strong> Luke Shepard</li>
            <li><strong>Classroom Anchor:</strong> Mr. Albo</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Curriculum -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">What We'll Learn</h2>
      
      <div class="space-y-4">
        <!-- Topic 1 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Building & Mechanisms</h3>
              <p class="text-gray-600">Learn to build different mechanisms and attachments. Explore how gears, levers, and motors work together.</p>
            </div>
          </div>
        </div>

        <!-- Topic 2 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Motor Control</h3>
              <p class="text-gray-600">Learn to program motors with timing and power levels. Control speed, direction, and duration.</p>
            </div>
          </div>
        </div>

        <!-- Topic 3 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Driving & Navigation</h3>
              <p class="text-gray-600">Build wheeled robots and learn to program movement sequences. Navigate paths and complete challenges.</p>
            </div>
          </div>
        </div>

        <!-- Topic 4 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-navy text-white rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Sensors & Reactions</h3>
              <p class="text-gray-600">Add sensors for color and distance detection. Make robots that react to their environment.</p>
            </div>
          </div>
        </div>

        <!-- Topic 5 -->
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-electric text-white rounded-xl flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy mb-1">Final Showcase</h3>
              <p class="text-gray-600">Put it all together! Pick a challenge, refine your robot, and present to families at the end-of-session showcase.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Dates -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">Save the Date</h2>
      
      <div class="max-w-md mx-auto">
        <div class="bg-gradient-to-br from-navy to-navy-dark rounded-2xl p-8 text-white text-center">
          <div class="text-sm font-medium opacity-80 mb-2">Final Showcase</div>
          <div class="text-4xl font-bold mb-2">May 4</div>
          <p class="opacity-90">Final presentations to families — see everything your kids have built!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Student Resources -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-6 text-center">Student Resources</h2>
      
      <div class="space-y-4">
        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <a href="https://docs.google.com/document/d/1hpmRyuHHaxoJZiRsXWPkJoB9Kd6JmYJl4ymF-hpu2Q0/edit?tab=t.0" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between group">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-electric/10 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-navy group-hover:text-electric transition-colors">Access Pybricks</h3>
                <p class="text-gray-500 text-sm">Instructions for accessing the Pybricks programming environment</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-electric transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-md border border-gray-100">
          <a href="/classes/mission-solutions" class="flex items-center justify-between group">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-electric/10 rounded-xl flex items-center justify-center">
                <svg class="w-6 h-6 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-navy group-hover:text-electric transition-colors">Mission Solutions</h3>
                <p class="text-gray-500 text-sm">Video tutorials & inspiration for FLL challenges</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-electric transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Back Link -->
  <section class="py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/classes" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to All Classes
      </a>
    </div>
  </section>
</BaseLayout>
