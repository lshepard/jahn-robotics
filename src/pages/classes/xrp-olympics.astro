---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="XRP Robot Olympics" description="Winter Olympics-inspired robot competitions for Advanced Robotics">
  <!-- Header -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block bg-electric/20 text-electric font-semibold text-sm px-4 py-2 rounded-full mb-6">
        🏆 Advanced Robotics Showcase
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4 animate-on-scroll">
        XRP Robot Olympics
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        May 6, 2026
      </p>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 shadow-lg">
        <p class="text-gray-700 leading-relaxed mb-4">
          Welcome to the Jahn Elementary XRP Robot Olympics! Our advanced robotics students have been 
          programming their XRP robots all semester, and now it's time to put their skills to the test 
          in a series of <strong>Winter Olympics-inspired competitions</strong>.
        </p>
        <p class="text-gray-700 leading-relaxed">
          Each team will compete in multiple events, earning points based on performance. Family and friends 
          are welcome to attend and cheer on the teams!
        </p>
      </div>
    </div>
  </section>

  <!-- Events Grid -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-navy mb-8 text-center">🎯 The Events</h2>
      
      <div class="grid gap-6 md:grid-cols-2">
        <!-- Speed Skating -->
        <div class="event-card rounded-2xl overflow-hidden shadow-lg">
          <div class="event-card-bg" style="background-image: url('/images/olympics/speed-skating.png');">
            <div class="event-card-overlay">
              <h3 class="text-xl font-bold text-white mb-2">Speed Skating</h3>
              <p class="text-white/90 text-sm mb-3">
                Race against the clock! Robots complete a full circle around the classroom as fast as possible. Fastest time wins.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Speed</span>
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Motor Control</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Skeleton -->
        <div class="event-card rounded-2xl overflow-hidden shadow-lg">
          <div class="event-card-bg" style="background-image: url('/images/olympics/skeleton-luge.png');">
            <div class="event-card-overlay">
              <h3 class="text-xl font-bold text-white mb-2">Skeleton</h3>
              <p class="text-white/90 text-sm mb-3">
                Navigate a maze course on paper with black tape — driver controlled! Guide your robot through without touching the walls.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Driving</span>
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Precision</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Luge -->
        <div class="event-card rounded-2xl overflow-hidden shadow-lg">
          <div class="event-card-bg" style="background-image: url('/images/olympics/skeleton-luge.png');">
            <div class="event-card-overlay">
              <h3 class="text-xl font-bold text-white mb-2">Luge</h3>
              <p class="text-white/90 text-sm mb-3">
                Same maze, but fully autonomous! Program your robot to follow the course using its light sensor. No human control allowed.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Line Following</span>
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Sensors</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hockey -->
        <div class="event-card rounded-2xl overflow-hidden shadow-lg">
          <div class="event-card-bg" style="background-image: url('/images/olympics/hockey.png');">
            <div class="event-card-overlay">
              <h3 class="text-xl font-bold text-white mb-2">Hockey</h3>
              <p class="text-white/90 text-sm mb-3">
                2v2 robot soccer on the FLL table! Work with a teammate to score goals while defending your own. Teamwork is key.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Strategy</span>
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Teamwork</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Curling -->
        <div class="event-card rounded-2xl overflow-hidden shadow-lg">
          <div class="event-card-bg" style="background-image: url('/images/olympics/curling.png');">
            <div class="event-card-overlay">
              <h3 class="text-xl font-bold text-white mb-2">Curling</h3>
              <p class="text-white/90 text-sm mb-3">
                Push a small ball or disc onto a target. Closest to the center wins! Precision and gentle control are everything.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Precision</span>
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Control</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Figure Skating -->
        <div class="event-card rounded-2xl overflow-hidden shadow-lg">
          <div class="event-card-bg" style="background-image: url('/images/olympics/figure-skating.png');">
            <div class="event-card-overlay">
              <h3 class="text-xl font-bold text-white mb-2">Figure Skating</h3>
              <p class="text-white/90 text-sm mb-3">
                Dress up your robot and program a dance routine to music! Judged on creativity, choreography, and style.
              </p>
              <div class="flex flex-wrap gap-2">
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Creativity</span>
                <span class="bg-white/20 text-white text-xs px-2 py-1 rounded-full">Programming</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About XRP -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 shadow-lg">
        <h2 class="text-2xl font-bold text-navy mb-4">🤖 About XRP</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          The <a href="https://www.sparkfun.com/xrp" target="_blank" rel="noopener noreferrer" class="text-electric hover:text-electric-dark font-medium">XRP (Experiential Robotics Platform)</a> is an 
          affordable, programmable robot designed for education. Our advanced students use Python to program 
          their XRPs, learning real-world coding skills while having fun with robotics.
        </p>
      </div>
    </div>
  </section>

  <!-- Back Link -->
  <section class="py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <a href="/classes/advanced-robotics" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-medium transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Advanced Robotics
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .event-card {
    transition: transform 0.2s ease;
  }
  
  .event-card:hover {
    transform: translateY(-4px);
  }
  
  .event-card-bg {
    background-size: cover;
    background-position: center;
    min-height: 280px;
  }
  
  .event-card-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 100%);
    min-height: 280px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
</style>
