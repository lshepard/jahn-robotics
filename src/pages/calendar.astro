---
import BaseLayout from '../layouts/BaseLayout.astro';

const events = [
  {
    date: 'May 20, 2026',
    title: 'Fall Season Info Kickoff',
    description: 'Join us to learn about FIRST LEGO League for the 2026-27 season. Meet our coaches, see what teams do, and find out how to sign up.',
    badge: 'Info Session',
    featured: true
  },
  {
    date: 'August 17-20, 2026',
    title: 'Robotics Summer Camp',
    description: 'Four days of hands-on robotics fun for kids',
    badge: 'Camp'
  },
  {
    date: 'September 2026',
    title: 'Fall Teams Begin',
    description: 'Competition teams start meeting weekly',
    badge: 'Teams'
  }
];
---

<BaseLayout title="Calendar" description="Key dates for Jahn Robotics - tournaments, classes, camps, and registration deadlines.">
  <!-- Hero Section -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Calendar
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Key dates for the year ahead
      </p>
    </div>
  </section>

  <!-- Events Section -->
  <section class="py-16 sm:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-6">
        {events.map((event, index) => (
          <div class={`rounded-2xl p-6 sm:p-8 shadow-lg animate-on-scroll stagger-${(index % 4) + 1} ${event.featured ? 'bg-electric text-white ring-4 ring-electric/30' : 'bg-white'}`}>
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
              <div class="flex-1">
                <span class={`inline-block font-semibold text-sm px-3 py-1 rounded-full mb-3 ${event.featured ? 'bg-white/20 text-white' : 'bg-electric/10 text-electric'}`}>
                  {event.badge}
                </span>
                <p class={`font-semibold text-lg mb-1 ${event.featured ? 'text-white/90' : 'text-electric'}`}>
                  {event.date}
                </p>
                <h2 class={`text-2xl font-bold mb-2 ${event.featured ? 'text-white' : 'text-navy'}`}>
                  {event.title}
                </h2>
                <p class={event.featured ? 'text-white/90' : 'text-gray-600'}>
                  {event.description}
                </p>
                {event.link && (
                  <a
                    href={event.link}
                    target={event.externalLink ? '_blank' : undefined}
                    rel={event.externalLink ? 'noopener noreferrer' : undefined}
                    class={`inline-flex items-center mt-4 font-semibold transition-colors ${event.featured ? 'text-white hover:text-white/80' : 'text-electric hover:text-electric-dark'}`}
                  >
                    {event.linkText}
                    {event.externalLink ? (
                      <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    ) : (
                      <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    )}
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Subscribe Button -->
      <div class="mt-12 text-center animate-on-scroll">
        <a
          href="https://calendar.google.com/calendar/u/0?cid=ZWYzOWE2NmI3YjgwNGMzNmMyODI4YzljZGYwZWUyODY3ODJjN2RkZTJkOWQ4M2ZjNWY2ZjMxZjEyNzg4YmRkY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 bg-electric text-white font-bold text-lg rounded-full hover:bg-electric-dark transition-colors shadow-lg hover:shadow-xl"
        >
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Subscribe to Calendar
        </a>
        <p class="mt-4 text-gray-500 text-sm">
          Add our calendar to stay updated on all events
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
