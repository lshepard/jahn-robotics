---
import BaseLayout from '../layouts/BaseLayout.astro';

const events = [
  {
    date: 'February 14, 2026',
    title: 'State Tournament',
    description: 'at Elgin Community College',
    badge: 'Competition',
    link: 'https://drive.google.com/file/d/13wrAElhotMe5H3Ko5yppNJuorI6YFTEi/view',
    linkText: 'Tournament Info',
    externalLink: true,
    teams: [
      { name: 'Fossilized Chickens', href: '/teams/unearthed/fossilized-chickens/' },
      { name: 'Indiana Drones', href: '/teams/unearthed/indiana-drones/' }
    ]
  },
  {
    date: 'February 23, 2026',
    title: 'Spring Classes Start',
    description: 'Weekly LEGO robotics classes begin',
    link: '/classes/',
    linkText: 'View Classes',
    badge: 'Classes'
  },
  {
    date: 'May 2026',
    title: 'Fall Team Signup',
    description: 'Registration opens for fall competition teams',
    badge: 'Registration'
  },
  {
    date: 'August 17-20, 2026',
    title: 'Robotics Summer Camp',
    description: 'Save these dates for our summer robotics camp',
    badge: 'Camp'
  }
];
---

<BaseLayout title="Calendar" description="Key dates for Jahn Robotics - tournaments, classes, camps, and registration deadlines.">
  <!-- Hero Section -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Calendar
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Key dates for the year ahead
      </p>
    </div>
  </section>

  <!-- Events Section -->
  <section class="py-16 sm:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-6">
        {events.map((event, index) => (
          <div class={`bg-white rounded-2xl p-6 sm:p-8 shadow-lg animate-on-scroll stagger-${(index % 4) + 1}`}>
            <div class="flex flex-col sm:flex-row sm:items-start gap-4">
              <div class="flex-1">
                <span class="inline-block bg-electric/10 text-electric font-semibold text-sm px-3 py-1 rounded-full mb-3">
                  {event.badge}
                </span>
                <p class="text-electric font-semibold text-lg mb-1">
                  {event.date}
                </p>
                <h2 class="text-2xl font-bold text-navy mb-2">
                  {event.title}
                </h2>
                <p class="text-gray-600">
                  {event.description}
                </p>
                {event.teams && (
                  <p class="mt-3 text-gray-600">
                    Two of our teams are advancing: {' '}
                    {event.teams.map((team, i) => (
                      <>
                        <a href={team.href} class="text-electric font-semibold hover:text-electric-dark transition-colors">
                          {team.name}
                        </a>
                        {i < event.teams.length - 1 && ' and '}
                      </>
                    ))}
                  </p>
                )}
                {event.link && (
                  <a
                    href={event.link}
                    target={event.externalLink ? '_blank' : undefined}
                    rel={event.externalLink ? 'noopener noreferrer' : undefined}
                    class="inline-flex items-center mt-4 text-electric font-semibold hover:text-electric-dark transition-colors"
                  >
                    {event.linkText}
                    {event.externalLink ? (
                      <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    ) : (
                      <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    )}
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Subscribe Button -->
      <div class="mt-12 text-center animate-on-scroll">
        <a
          href="https://calendar.google.com/calendar/u/0?cid=ZWYzOWE2NmI3YjgwNGMzNmMyODI4YzljZGYwZWUyODY3ODJjN2RkZTJkOWQ4M2ZjNWY2ZjMxZjEyNzg4YmRkY0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-8 py-4 bg-electric text-white font-bold text-lg rounded-full hover:bg-electric-dark transition-colors shadow-lg hover:shadow-xl"
        >
          <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Subscribe to Calendar
        </a>
        <p class="mt-4 text-gray-500 text-sm">
          Add our calendar to stay updated on all events
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
