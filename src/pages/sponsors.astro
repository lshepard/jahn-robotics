---
import BaseLayout from '../layouts/BaseLayout.astro';

const sponsors = [
  {
    name: 'FIRST Illinois Robotics',
    logo: '/images/sponsors/first-illinois.svg',
    url: 'https://www.firstillinoisrobotics.org/',
  },
  {
    name: 'CPS Robotics',
    logo: '/images/sponsors/cps-robotics.png',
    url: 'https://sites.google.com/cps.edu/cs4all/robotics',
  },
  {
    name: 'Boys & Girls Clubs of Chicago — Gantz Club',
    logo: '/images/sponsors/bgcc.png',
    url: 'https://bgcc.org/gantz-club/',
  },
  {
    name: 'Roscoe Village Neighbors',
    logo: '/images/sponsors/roscoe-village.png',
    url: 'https://www.roscoevillage.org/',
  },
  {
    name: 'ARCO Murray — Bike Ride for the Kids',
    logo: '/images/sponsors/arco-murray.jpg',
    url: 'https://www.arcomurray.com/social-impact/',
  },
  {
    name: 'Friends of Jahn',
    logo: '/images/sponsors/friendsofjahn.png',
    url: 'https://www.jahnschool.com/apps/pages/FOJ',
  },
  {
    name: 'Jahn School of Fine Arts',
    logo: '/images/sponsors/jahn.png',
    url: 'https://jahnschool.com/robotics',
  },
  {
    name: 'Building Blocks Toys',
    logo: '/images/sponsors/building-blocks.png',
    url: 'https://www.buildingblockstoys.com/',
  },
];
---

<BaseLayout title="Sponsors" description="Thank you to the organizations that support Jahn Robotics through mentorship, funding, and community partnership.">
  <!-- Header -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-20">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/teams/full-team.jpeg');"
    ></div>
    <div class="absolute inset-0 bg-navy/85"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Our Sponsors & Partners
      </h1>
      <p class="text-xl text-white/80 leading-relaxed animate-on-scroll max-w-2xl mx-auto">
        Jahn Robotics wouldn't be possible without the generous support of these organizations
        who have mentored our teams and helped fund our program over the years.
      </p>
    </div>
  </section>

  <!-- Sponsor Grid -->
  <section class="py-12 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {sponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 hover:border-electric/30 flex flex-col"
          >
            <div class="h-24 flex items-center justify-center mb-6">
              <img
                src={sponsor.logo}
                alt={sponsor.name}
                class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <h3 class="text-lg font-bold text-navy mb-2 group-hover:text-electric transition-colors text-center">
              {sponsor.name}
            </h3>
            <div class="mt-auto pt-4 text-electric text-sm font-medium flex items-center justify-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              Visit website
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Support Us CTA -->
  <section class="py-12 sm:py-16 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Want to Support Jahn Robotics?</h2>
      <p class="text-white/70 mb-8 max-w-2xl mx-auto">
        We're always looking for sponsors, mentors, and community partners to help our students
        succeed in FIRST LEGO League. Whether it's equipment donations, coaching support, or
        financial contributions, every bit helps.
      </p>
      <a
        href="/volunteers/"
        class="inline-flex items-center gap-2 bg-electric hover:bg-electric-dark text-white font-semibold px-6 py-3 rounded-xl transition-all"
      >
        Get Involved
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
