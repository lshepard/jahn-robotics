---
import BaseLayout from '../layouts/BaseLayout.astro';

const sponsors = [
  {
    name: 'FIRST Illinois Robotics',
    logo: '/images/sponsors/first-illinois.svg',
    url: 'https://www.firstillinoisrobotics.org/',
    description: 'Our state FIRST partner, organizing competitions and supporting robotics programs across Illinois.'
  },
  {
    name: 'CPS Robotics',
    logo: '/images/sponsors/cps-robotics.png',
    url: 'https://sites.google.com/cps.edu/cs4all/robotics',
    description: 'Chicago Public Schools Robotics program, bringing robotics and CS education to students district-wide.'
  },
  {
    name: 'Boys & Girls Clubs of Chicago — Gantz Club',
    logo: '/images/sponsors/bgcc.png',
    url: 'https://bgcc.org/gantz-club/',
    description: 'Providing space and support for our summer kickoff programs and team activities.'
  },
  {
    name: 'Roscoe Village Neighbors',
    logo: '/images/sponsors/roscoe-village.png',
    url: 'https://www.roscoevillage.org/',
    description: 'Our neighborhood association, supporting local youth programs and community initiatives.'
  },
  {
    name: 'ARCO Murray — Bike Ride for the Kids',
    logo: '/images/sponsors/arco-murray.jpg',
    url: 'https://www.arcomurray.com/social-impact/',
    description: 'Funding youth programs through their annual Bike Ride for the Kids charity event.'
  },
  {
    name: 'Friends of Jahn',
    logo: '/images/sponsors/friendsofjahn.png',
    url: 'https://www.jahnschool.com/apps/pages/FOJ',
    description: 'Our parent organization that helps fund school programs and enrichment activities.'
  },
  {
    name: 'Jahn School of Fine Arts',
    logo: '/images/sponsors/jahn.png',
    url: 'https://jahnschool.com/robotics',
    description: 'Our home school, providing facilities and administrative support for the robotics program.'
  },
  {
    name: 'Building Blocks Toys',
    logo: '/images/sponsors/building-blocks.png',
    url: 'https://www.buildingblockstoys.com/',
    description: 'A local toy store supporting STEM education and providing robotics supplies.'
  },
];
---

<BaseLayout title="Sponsors" description="Thank you to the organizations that support Jahn Robotics through mentorship, funding, and community partnership.">
  <!-- Header -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-20">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/teams/full-team.jpeg');"
    ></div>
    <div class="absolute inset-0 bg-navy/85"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Our Sponsors & Partners
      </h1>
      <p class="text-xl text-white/80 leading-relaxed animate-on-scroll max-w-2xl mx-auto">
        Jahn Robotics wouldn't be possible without the generous support of these organizations
        who have mentored our teams and helped fund our program over the years.
      </p>
    </div>
  </section>

  <!-- Thank You Message -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-white rounded-2xl p-8 sm:p-10 shadow-sm">
        <svg class="w-12 h-12 text-electric mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
        </svg>
        <h2 class="text-2xl sm:text-3xl font-bold text-navy mb-4">Thank You!</h2>
        <p class="text-gray-600 text-lg leading-relaxed max-w-2xl mx-auto">
          Our robotics program has grown from a single team to four competitive teams thanks to
          the incredible support of our community. From equipment donations to mentorship,
          every contribution helps our students learn, grow, and succeed.
        </p>
      </div>
    </div>
  </section>

  <!-- Sponsor Grid -->
  <section class="py-12 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {sponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl p-6 sm:p-8 shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 hover:border-electric/30 flex flex-col"
          >
            <div class="h-24 flex items-center justify-center mb-6">
              <img
                src={sponsor.logo}
                alt={sponsor.name}
                class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <h3 class="text-lg font-bold text-navy mb-2 group-hover:text-electric transition-colors">
              {sponsor.name}
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed flex-1">
              {sponsor.description}
            </p>
            <div class="mt-4 text-electric text-sm font-medium flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
              Visit website
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Support Us CTA -->
  <section class="py-12 sm:py-16 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">Want to Support Jahn Robotics?</h2>
      <p class="text-white/70 mb-8 max-w-2xl mx-auto">
        We're always looking for sponsors, mentors, and community partners to help our students
        succeed in FIRST LEGO League. Whether it's equipment donations, coaching support, or
        financial contributions, every bit helps.
      </p>
      <a
        href="/volunteers/"
        class="inline-flex items-center gap-2 bg-electric hover:bg-electric-dark text-white font-semibold px-6 py-3 rounded-xl transition-all"
      >
        Get Involved
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
