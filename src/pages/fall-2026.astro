---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fall 2026 Season" description="Sign up for Jahn Robotics Fall 2026 season">
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/fll-2026-27-teaser-22s.jpg');"
    ></div>
        <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Fall 2026 Season
      </h1>

      <!-- Video -->
      <div class="mb-10 animate-on-scroll">
        <video
          class="w-full max-w-3xl mx-auto rounded-2xl shadow-xl"
          controls
          playsinline
        >
          <source src="/videos/FLLTeaserBioglow.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>

      <!-- Key Dates -->
      <div class="bg-white/95 rounded-2xl p-8 sm:p-10 animate-on-scroll mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-navy mb-6">Key Dates</h2>
        <div class="space-y-4 text-left">
          <div class="flex items-start gap-4 p-4 bg-electric/10 rounded-xl border-l-4 border-electric">
            <div class="text-electric font-bold text-lg whitespace-nowrap">May 19</div>
            <div class="text-gray-700">
              <span class="font-semibold">Fall Info Session</span>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-electric/10 rounded-xl border-l-4 border-electric">
            <div class="text-electric font-bold text-lg whitespace-nowrap">Aug 4</div>
            <div class="text-gray-700">
              <span class="font-semibold">Season Launch</span>
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-electric/10 rounded-xl border-l-4 border-electric">
            <div class="text-electric font-bold text-lg whitespace-nowrap">Aug 17-20</div>
            <div class="text-gray-700">
              <span class="font-semibold">FLL Summer Kickoff</span> at the Boys and Girls Club on Leavitt (hold these dates!)
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-electric/10 rounded-xl border-l-4 border-electric">
            <div class="text-electric font-bold text-lg whitespace-nowrap">Week of Aug 31</div>
            <div class="text-gray-700">
              <span class="font-semibold">Practice Starts</span> — exact schedule TBD
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-gray-100 rounded-xl border-l-4 border-gray-400">
            <div class="text-gray-600 font-bold text-lg whitespace-nowrap">Dec 2026</div>
            <div class="text-gray-700">
              <span class="font-semibold">Qualifier Tournament</span> (estimated)
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-gray-100 rounded-xl border-l-4 border-gray-400">
            <div class="text-gray-600 font-bold text-lg whitespace-nowrap">Jan 2027</div>
            <div class="text-gray-700">
              <span class="font-semibold">Sectionals</span> (estimated)
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-gray-100 rounded-xl border-l-4 border-gray-400">
            <div class="text-gray-600 font-bold text-lg whitespace-nowrap">Feb 2027</div>
            <div class="text-gray-700">
              <span class="font-semibold">State Tournament</span> (estimated)
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
