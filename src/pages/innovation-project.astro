---
import BaseLayout from '../layouts/BaseLayout.astro';

// Innovation Project resources. Like the robot resources page, the arrays below
// drive the markup — add links here and they render automatically.

const sections = [
  { id: 'steps', label: 'The Process' },
  { id: 'rubric', label: 'How It Is Judged' },
];

// The five steps FIRST asks teams to work through.
const steps = [
  {
    n: 1,
    name: 'Identify',
    desc: 'Find a real problem related to this season’s theme that your team genuinely cares about.',
  },
  {
    n: 2,
    name: 'Design',
    desc: 'Research what already exists and who it affects, then come up with ideas nobody has tried yet.',
  },
  {
    n: 3,
    name: 'Create',
    desc: 'Build a model, drawing, or prototype that makes your solution something people can see.',
  },
  {
    n: 4,
    name: 'Iterate',
    desc: 'Share it with people who know the problem, collect their feedback, and improve the design.',
  },
  {
    n: 5,
    name: 'Communicate',
    desc: 'Present your solution and the story of how it changed along the way.',
  },
];

// Official materials. The rubric is mirrored locally with the other season PDFs.
const resources = [
  {
    name: 'Innovation Project Rubric',
    href: '/resources/bioglow/bioglow-innovation-project-rubric.pdf',
    desc: 'Exactly what judges look for, from Beginning to Exceeds. Read it before you start, not the night before.',
    tag: 'PDF · 1 page',
  },
  {
    name: 'FIRST Season Materials',
    href: 'https://www.firstinspires.org/resources/library/fll/season-materials',
    desc: 'The official BIOGLOW library — the engineering notebook, judging materials, and challenge updates.',
    tag: 'firstinspires.org',
    external: true,
  },
];
---

<BaseLayout
  title="Innovation Project"
  description="Resources for the FIRST LEGO League Innovation Project — the research and design half of the BIOGLOW season"
>
  <!-- Hero -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-20 overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/fll/bioglow-background.png');"
    ></div>
    <div class="absolute inset-0 bg-navy/80"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-green/20 text-green font-semibold text-sm px-4 py-1 rounded-full mb-4">
        2026-27 Season
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Innovation Project
      </h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto animate-on-scroll">
        Half of FIRST LEGO League is the robot. The other half is finding a real problem in the
        world and designing a better solution for it.
      </p>
    </div>
  </section>

  <!-- Sticky section nav -->
  <nav class="sticky top-16 sm:top-20 z-30 bg-navy-light/95 backdrop-blur-md border-y border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-1 overflow-x-auto py-2 -mx-1 px-1">
        {sections.map((s) => (
          <a
            href={`#${s.id}`}
            class="whitespace-nowrap px-3 py-2 rounded-lg text-sm font-medium text-white/70 hover:text-white hover:bg-white/10 transition-colors"
          >
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <div class="bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16 sm:space-y-20">

      <!-- THIS SEASON -->
      <section id="theme" class="scroll-mt-40">
        <div class="bg-navy rounded-2xl p-6 sm:p-8 shadow-lg animate-on-scroll">
          <span class="text-xs font-semibold uppercase tracking-wide text-electric">
            This season&rsquo;s theme
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold text-white mt-1 mb-3">Diversity of Life</h2>
          <p class="text-white/70 text-sm sm:text-base max-w-3xl">
            BIOGLOW is about the living world &mdash; the species we share it with, the habitats
            they depend on, and what happens when those habitats change. Your project should
            identify a specific problem in that space and propose a solution nobody has built yet.
          </p>
        </div>
      </section>

      <!-- THE PROCESS -->
      <section id="steps" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">The Process</h2>
        <p class="text-gray-600 mb-8 max-w-2xl animate-on-scroll">
          Five steps, and judges ask about all of them. The ones teams skip most often are
          <span class="font-semibold text-navy">Iterate</span> and sharing with real experts &mdash;
          that is usually what separates a good project from a winning one.
        </p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {steps.map((s, i) => (
            <div
              class={`bg-white rounded-2xl p-6 shadow-lg animate-on-scroll${i > 0 ? ` stagger-${Math.min(i + 1, 4)}` : ''}`}
            >
              <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-green/15 text-navy font-bold mb-3">
                {s.n}
              </span>
              <h3 class="font-bold text-navy text-lg mb-2">{s.name}</h3>
              <p class="text-gray-600 text-sm">{s.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- HOW IT IS JUDGED -->
      <section id="rubric" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">How it is judged</h2>
        <p class="text-gray-600 mb-8 max-w-2xl animate-on-scroll">
          Judges score the project on the rubric below, and they ask follow-up questions. Know your
          own project well enough to answer them.
        </p>

        <div class="grid sm:grid-cols-2 gap-6">
          {resources.map((r, i) => (
            <a
              href={r.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`group flex flex-col bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll${i > 0 ? ` stagger-${i + 1}` : ''}`}
            >
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">{r.tag}</span>
              <h3 class="font-bold text-navy text-lg mt-1 mb-2 group-hover:text-electric transition-colors">
                {r.name}
              </h3>
              <p class="text-gray-600 text-sm">{r.desc}</p>
            </a>
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
