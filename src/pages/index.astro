---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaHero from '../components/shared/MediaHero.astro';
import { getCurrentYearMedia } from '../lib/media';

const signupUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSc_QRV6zuepd_8dFaJoLw1aRE797RwnTEhibXRxL0-lRaA4Tw/viewform';

// Get all media for the hero and photos for the gallery
const allMedia = getCurrentYearMedia();
const photos = allMedia.filter(m => m.type === 'photo');
---

<BaseLayout title="Home" isHome>
  <!-- Hero Section -->
  <section class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden">
    <!-- Video/photo background montage -->
    <MediaHero
      media={allMedia}
      fallbackImage="/images/hero-poster.jpg"
      overlayClass="bg-gradient-to-b from-navy/70 via-navy/50 to-navy/90"
    />

    <!-- Content -->
    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <div class="animate-on-scroll">
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold text-white mb-8 leading-tight tracking-tight">
          Award-Winning
          <span class="text-electric"> Robotics Program</span>
        </h1>
        <a
          href={signupUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-orange hover:bg-orange-dark text-white font-semibold px-8 py-4 rounded-xl text-lg transition-all hover:scale-105 shadow-lg shadow-orange/25"
        >
          Sign Up for Fall 2026
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Video Section -->
  <section class="relative py-16 sm:py-20 overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/fll/bioglow-background.png');"
    ></div>
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 animate-on-scroll">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">This Year's Challenge: BIOGLOW</h2>
        <p class="text-white/70">Watch the official FIRST LEGO League season teaser</p>
      </div>
      <div class="animate-on-scroll">
        <video
          class="w-full max-w-3xl mx-auto rounded-2xl shadow-xl"
          controls
          playsinline
          poster="/images/fll/bioglow-placeholder.png"
        >
          <source src="/videos/FLLTeaserBioglow.mp4" type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>

      <!-- Key Dates Timeline -->
      <div class="mt-16">
        <div class="text-center mb-10 animate-on-scroll">
          <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Key Dates</h2>
          <p class="text-white/70">Mark your calendar for the 2026-27 season</p>
        </div>
        <div class="space-y-4 animate-on-scroll">
          class="flex items-start gap-4 p-4 bg-orange/20 rounded-xl border-l-4 border-orange">
          <div class="flex items-start gap-4 p-4 bg-white/10 rounded-xl border-l-4 border-electric">
            <div class="text-electric font-bold text-lg whitespace-nowrap">Aug 4</div>
            <div class="text-white/90">
              <span class="font-semibold">Season Launch</span> — Official challenge reveal
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-white/10 rounded-xl border-l-4 border-electric">
            <div class="text-electric font-bold text-lg whitespace-nowrap">Aug 17-20</div>
            <div class="text-white/90">
              <span class="font-semibold">FLL Summer Kickoff</span> at the Boys and Girls Club on Leavitt (highly recommended!)
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-white/10 rounded-xl border-l-4 border-electric">
            <div class="text-electric font-bold text-lg whitespace-nowrap">Week of Aug 31</div>
            <div class="text-white/90">
              <span class="font-semibold">Practice Starts</span> — Exact schedule TBD
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border-l-4 border-white/40">
            <div class="text-white/60 font-bold text-lg whitespace-nowrap">Dec 2026</div>
            <div class="text-white/70">
              <span class="font-semibold">Qualifier Tournament</span> (estimated)
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border-l-4 border-white/40">
            <div class="text-white/60 font-bold text-lg whitespace-nowrap">Jan 2027</div>
            <div class="text-white/70">
              <span class="font-semibold">Sectionals</span> (estimated)
            </div>
          </div>
          <div class="flex items-start gap-4 p-4 bg-white/5 rounded-xl border-l-4 border-white/40">
            <div class="text-white/60 font-bold text-lg whitespace-nowrap">Feb 2027</div>
            <div class="text-white/70">
              <span class="font-semibold">State Tournament</span> (estimated)
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo Gallery from Last Season -->
  {photos.length > 0 && (
    <section class="py-16 sm:py-20 bg-gray-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10 animate-on-scroll">
          <h2 class="text-2xl sm:text-3xl font-bold text-navy mb-3">Last Season Highlights</h2>
          <p class="text-gray-600">Our teams in action during the UNEARTHED 2025-26 season</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 animate-on-scroll">
          {photos.slice(0, 8).map((photo) => (
            <div class="media-gallery-item relative group cursor-pointer rounded-xl overflow-hidden aspect-square bg-gray-200">
              <img
                src={photo.src}
                alt=""
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          ))}
        </div>

        <div class="text-center mt-8 animate-on-scroll">
          <a href="/teams/" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-semibold transition-colors">
            See previous seasons
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Lightbox overlay -->
      <div class="media-lightbox fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4" id="media-lightbox">
        <button class="absolute top-4 right-4 text-white/70 hover:text-white z-10" id="lightbox-close">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <div class="max-w-5xl max-h-[90vh] w-full flex items-center justify-center" id="lightbox-content">
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA -->
  <section class="py-16 sm:py-24 bg-gradient-to-br from-electric to-electric-dark">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-on-scroll">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        Ready to Join the Team?
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        Sign up by Memorial Day to be placed on a team for fall 2026. Open to 4th-8th graders — no experience needed!
      </p>
      <a
        href={signupUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white text-electric font-semibold px-8 py-4 rounded-xl text-lg transition-all hover:scale-105 shadow-lg"
      >
        Sign Up Now
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  function initGallery() {
    const lightbox = document.getElementById('media-lightbox');
    const content = document.getElementById('lightbox-content');
    const closeBtn = document.getElementById('lightbox-close');
    if (!lightbox || !content || !closeBtn) return;

    function openLightbox(el: HTMLElement) {
      const img = el.querySelector('img');
      content.innerHTML = '';

      if (img) {
        const expanded = document.createElement('img');
        expanded.src = img.src;
        expanded.alt = '';
        expanded.className = 'max-w-full max-h-[85vh] rounded-lg object-contain';
        content.appendChild(expanded);
      }

      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
    }

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      content.innerHTML = '';
    }

    document.querySelectorAll<HTMLElement>('.media-gallery-item').forEach(item => {
      item.addEventListener('click', () => openLightbox(item));
    });

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  }

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
