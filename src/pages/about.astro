---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllMedia } from '../lib/media';

const media = getAllMedia();
// Pick a few photos for the page (filter to photos only)
const photos = media.filter(m => m.type === 'photo').slice(0, 6);
---

<BaseLayout title="About" description="Learn about the Jahn Robotics program — how we started, how we've grown, and what we believe in.">
  <!-- Header with photo -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-20">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/teams/full-team.jpeg');"
    ></div>
    <div class="absolute inset-0 bg-navy/80"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        About Jahn Robotics
      </h1>
      <p class="text-xl text-white/80 leading-relaxed animate-on-scroll">
        We're a FIRST LEGO League program at Jahn Elementary in Chicago Public Schools.
        We are a coalition of parents, teachers, staff and community volunteers that work together
        to help kids learn and grow as engineers and innovators.
      </p>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">How We Got Here</h2>

        <p class="text-gray-700 leading-relaxed mb-6">
          In fall 2023, we introduced a robotics club at Jahn with some used EV3 bots and
          a group of enthusiastic students, parents, and teachers. That first team — the <a href="/teams/masterpiece/jahn-rad-robots/">Jahn Rad Robots</a> —
          grew quickly, and surprised us all by competing in the Illinois State Competition. Since then, the program has grown and added students every year. In 2025-26,
	  we fielded four teams with ten volunteer coaches. Every team brought home an award from their tournaments, and 
          multiple teams have qualified for State. More importantly, the kids have learned so much about engineering,
          programming, speaking, teamwork, and innovation.
        </p>

      </div>

      {/* Photo grid */}
      {photos.length > 0 && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-10">
          {photos.map((photo) => (
            <div class="aspect-video rounded-xl overflow-hidden bg-gray-100">
              <img src={photo.src} alt="" class="w-full h-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- FIRST LEGO League -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-navy rounded-2xl p-8 sm:p-10 text-center">
        <img src="/images/fll/fll-challenge-reverse.png" alt="FIRST LEGO League Challenge" class="h-12 sm:h-14 w-auto mx-auto mb-6 object-contain" />
        <h2 class="text-2xl font-bold text-white mb-4">About FIRST LEGO League</h2>
        <p class="text-white/70 mb-6 max-w-2xl mx-auto">
          FIRST LEGO League introduces students in 4th to 8th grade to STEM through hands-on robotics.
          Teams research real-world problems, build autonomous robots, and compete at tournaments
          where they're judged on their robot performance, innovation project, and core values.
        </p>
        <a
          href="https://www.firstlegoleague.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-electric hover:bg-electric-dark text-white font-semibold px-6 py-3 rounded-xl transition-all"
        >
          Learn more about FLL
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
