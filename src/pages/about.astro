---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllMedia } from '../lib/media';

const media = getAllMedia();
// Pick a few photos for the page (filter to photos only)
const photos = media.filter(m => m.type === 'photo').slice(0, 6);
---

<BaseLayout title="About" description="Learn about the Jahn Robotics program — how we started, how we've grown, and what we believe in.">
  <!-- Header with photo -->
  <section class="bg-navy pt-28 sm:pt-32 pb-16 sm:pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        About Jahn Robotics
      </h1>
      <p class="text-xl text-white/80 leading-relaxed animate-on-scroll">
        We're a FIRST LEGO League program at Jahn Elementary in Chicago Public Schools.
        We are a coalition of parents, teachers, staff and community volunteers that work together
        to help kids learn and grow as engineers and public speakers. What started as one team in 2023
        has grown into something we're really proud of.
      </p>
    </div>
  </section>

  <!-- Our Story -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg max-w-none">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">How We Got Here</h2>

        <p class="text-gray-700 leading-relaxed mb-6">
          In fall 2023, we introduced a robotics club at Jahn with some used EV3 bots and
          a group of enthusiastic students, parents, and teachers. That first team — the Jahn Rad Robots —
          grew quickly, and surprised us all by competing in the Illinois State Competition. Since then, the program has grown and added students every year. This year we have four teams and 
          ten volunteer coaches. Every single team brought home an award from their tournaments, and 
          multiple teams have qualified for State. More importantly, the kids have learned so much about engineering,
          programming, 
        </p>

      </div>

      {/* Photo grid */}
      {photos.length > 0 && (
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-10">
          {photos.map((photo) => (
            <div class="aspect-video rounded-xl overflow-hidden bg-gray-100">
              <img src={photo.src} alt="" class="w-full h-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- Core Values -->
  <section class="py-12 sm:py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">What We Believe In</h2>
      <p class="text-gray-600 mb-8">
        FIRST LEGO League is built on a set of Core Values that guide how teams work together.
        Here's how we try to live them out:
      </p>

      <div class="space-y-6">
        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-gray-900 mb-2">Inclusion</h3>
          <p class="text-gray-600">
            We respect each other and embrace our differences. At Jahn, this means that there is
            a space for *everyone* on the robotics team - no experience, no cuts.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-gray-900 mb-2">Discovery</h3>
          <p class="text-gray-600">
            We explore new skills and ideas. Beyond competition season, we run spring coding classes
            so more students can get introduced to programming and robotics before joining a team.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-gray-900 mb-2">Innovation</h3>
          <p class="text-gray-600">
            We use creativity and persistence to solve problems. Each team tackles a real-world challenge
            for their Innovation Project — this year's teams are working on solutions related to
            underground farming, cave exploration, and mining safety.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-gray-900 mb-2">Teamwork</h3>
          <p class="text-gray-600">
            We are stronger when we work together. Our teams are coached by parent-teacher duos
            who bring different skills to the table. Students learn that building a robot is a team effort —
            coders need builders, presenters need researchers, and everyone needs encouragement.
          </p>
        </div>

        <div class="bg-white rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-gray-900 mb-2">Fun</h3>
          <p class="text-gray-600">
            We enjoy and celebrate what we do. Yes, competitions are intense. But if kids aren't
            having fun, we're doing it wrong. The best moments are often the small ones — a robot
            finally working, a team joke that sticks, the bus ride home after a tournament.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FIRST LEGO League -->
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-navy rounded-2xl p-8 sm:p-10 text-center">
        <img src="/images/fll/fll-challenge-reverse.png" alt="FIRST LEGO League Challenge" class="h-12 sm:h-14 w-auto mx-auto mb-6 object-contain" />
        <h2 class="text-2xl font-bold text-white mb-4">About FIRST LEGO League</h2>
        <p class="text-white/70 mb-6 max-w-2xl mx-auto">
          FIRST LEGO League introduces students in 4th to 8th grade to STEM through hands-on robotics.
          Teams research real-world problems, build autonomous robots, and compete at tournaments
          where they're judged on their robot performance, innovation project, and core values such as teamwork.
        </p>
        <a
          href="https://www.firstlegoleague.org/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-electric hover:bg-electric-dark text-white font-semibold px-6 py-3 rounded-xl transition-all"
        >
          Learn more about FLL
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
