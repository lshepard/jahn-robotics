---
import BaseLayout from '../layouts/BaseLayout.astro';

// Our Playlab assistant, scoped to Pybricks robot coding. Swap the id here if
// we publish a new version of the app.
//
// This opens in a new tab rather than an iframe on purpose: playlab.ai serves
// `x-frame-options: SAMEORIGIN` on every path, including /embedded/, so a
// browser refuses to render it inside our page. If Playlab ever allows
// third-party framing, the embed snippet is in the comment below.
//   <iframe src={playlabApp} height="700" allow="clipboard-write" ...>
const playlabApp = 'https://www.playlab.ai/embedded/cmsynht9i652bl20wk2qtjxm4';

// Prompts that get a useful answer back. Vague questions get vague help, so
// these all model the same thing: say what you tried and what happened.
const goodPrompts = [
  'My robot turns 90 degrees but overshoots every time. Here is my code — what should I change?',
  'How do I use the gyro sensor in Pybricks to drive straight?',
  'Explain what this block of code does, line by line.',
  'My attachment motor runs before the robot finishes driving. How do I make it wait?',
];

// What the assistant is good for versus what it cannot do for you.
const guidance = [
  {
    title: 'Ask it to explain, not just fix',
    desc: 'Asking "why did that work?" after it helps you is how you get better. Copying a fix you do not understand will not help you at the tournament.',
    good: true,
  },
  {
    title: 'Bring your actual code and the actual error',
    desc: 'Paste what you wrote and describe what the robot really did. "It does not work" is not enough for anyone to help you, human or AI.',
    good: true,
  },
  {
    title: 'Test everything on the real robot',
    desc: 'The AI cannot see your robot, your attachments, or your table. It will sometimes give code that looks right and does not run. You are the one who checks.',
    good: true,
  },
  {
    title: 'Never share personal information',
    desc: 'No full names, no school details, no addresses, no photos of yourselves. Coaches can review how the app is used.',
    good: false,
  },
  {
    title: 'It is your robot, not the AI’s',
    desc: 'Judges ask how your team solved a problem, and "the AI told us" is not an answer. Use it the way you would use a coach or a tutorial — as help, not as the author of your work.',
    good: false,
  },
];
---

<BaseLayout
  title="Ask AI for Help"
  description="How Jahn Robotics teams use our Playlab AI assistant for Pybricks robot coding advice"
>
  <!-- Hero -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-20 overflow-hidden bg-navy">
    <div class="absolute inset-0 bg-gradient-to-br from-navy via-navy-light to-navy"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-electric/20 text-electric font-semibold text-sm px-4 py-1 rounded-full mb-4">
        For Teams
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Ask AI for Help
      </h1>
      <p class="text-white/80 text-lg max-w-2xl mx-auto animate-on-scroll">
        A coding assistant that knows Pybricks. Stuck on a program, a sensor, or a turn that
        will not come out right? Ask it here.
      </p>
    </div>
  </section>

  <div class="bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16 sm:space-y-20">

      <!-- THE ASSISTANT -->
      <section id="assistant" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">
          Pybricks Robot Coding Helper
        </h2>
        <p class="text-gray-600 mb-8 max-w-2xl animate-on-scroll">
          Ask for help designing your robot, building attachments, or writing Pybricks code.
          The assistant opens in a new tab &mdash; click
          <span class="font-semibold text-navy">Start</span> there to begin a conversation.
        </p>

        <a
          href={playlabApp}
          target="_blank"
          rel="noopener noreferrer"
          class="group block bg-navy rounded-2xl p-6 sm:p-10 shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll"
        >
          <div class="flex flex-col sm:flex-row sm:items-center gap-6">
            <div class="shrink-0 w-16 h-16 rounded-2xl bg-electric/20 flex items-center justify-center">
              <svg class="w-8 h-8 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
            </div>
            <div class="min-w-0">
              <h3 class="font-bold text-white text-xl sm:text-2xl mb-1">
                Open the Pybricks Coding Helper
              </h3>
              <p class="text-white/70 text-sm sm:text-base">
                Bring your code and a clear description of what the robot actually did.
              </p>
            </div>
            <span class="sm:ml-auto shrink-0 inline-flex items-center gap-2 text-electric font-semibold group-hover:text-white transition-colors">
              Launch
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </span>
          </div>
        </a>

        <p class="text-sm text-gray-500 mt-4 max-w-2xl animate-on-scroll">
          Built with <a href="https://www.playlab.ai/" target="_blank" rel="noopener noreferrer" class="text-electric font-medium hover:underline">Playlab</a>.
          Coaches can review how the assistant is used.
        </p>
      </section>

      <!-- HOW TO ASK -->
      <section id="how-to-ask" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">How to ask a good question</h2>
        <p class="text-gray-600 mb-8 max-w-2xl animate-on-scroll">
          The more specific you are, the more useful the answer. Try questions like these:
        </p>

        <ul class="space-y-3">
          {goodPrompts.map((p, i) => (
            <li
              class={`flex items-start gap-3 bg-white rounded-xl p-4 shadow-md animate-on-scroll${i > 0 ? ` stagger-${Math.min(i + 1, 4)}` : ''}`}
            >
              <svg class="w-5 h-5 shrink-0 mt-0.5 text-electric" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
              <span class="text-gray-700 text-sm sm:text-base">&ldquo;{p}&rdquo;</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- RULES OF THUMB -->
      <section id="using-it-well" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">Using it well</h2>
        <p class="text-gray-600 mb-8 max-w-3xl animate-on-scroll">
          AI is a tool, like a wrench or a tutorial video. It is genuinely useful and it is also
          confidently wrong sometimes. These are the habits that keep it helping you instead of
          doing your thinking for you.
        </p>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {guidance.map((g, i) => (
            <div
              class={`bg-white rounded-2xl p-6 shadow-lg animate-on-scroll${i > 0 ? ` stagger-${Math.min(i + 1, 4)}` : ''}`}
            >
              <div
                class:list={[
                  'w-10 h-10 rounded-xl flex items-center justify-center mb-3',
                  g.good ? 'bg-green/15' : 'bg-orange/15',
                ]}
              >
                {g.good ? (
                  <svg class="w-5 h-5 text-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                ) : (
                  <svg class="w-5 h-5 text-orange-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                  </svg>
                )}
              </div>
              <h3 class="font-bold text-navy mb-2">{g.title}</h3>
              <p class="text-gray-600 text-sm">{g.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- CORE VALUES TIE-IN -->
      <section id="core-values" class="scroll-mt-40">
        <div class="bg-navy rounded-2xl p-6 sm:p-8 shadow-lg animate-on-scroll">
          <h2 class="text-2xl font-bold text-white mb-2">This is a Core Values question too</h2>
          <p class="text-white/70 text-sm sm:text-base max-w-3xl mb-4">
            <span class="font-semibold text-white">Discovery</span> and
            <span class="font-semibold text-white">Innovation</span> mean exploring new tools &mdash;
            AI included. But FIRST asks that the work you present be genuinely yours. Use the
            assistant to learn faster, then be ready to explain every line of your program in your
            own words. If you cannot explain it, you are not done yet.
          </p>
          <a
            href="/resources/"
            class="text-electric font-semibold text-sm hover:text-white transition-colors"
          >
            Browse robot design resources &rarr;
          </a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
