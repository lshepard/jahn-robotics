---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Summer Camp" description="Robotics Summer Kickoff - August 17-20, 2026 at the Boys & Girls Club">
  <!-- Hero Section -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-electric/20 text-electric font-semibold text-sm px-4 py-1 rounded-full mb-4">
        August 17-20, 2026
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Robotics Summer Kickoff
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll max-w-2xl mx-auto">
        Four days of hands-on robotics to kick off the BIOGLOW season
      </p>
    </div>
  </section>

  <!-- Details Section -->
  <section class="py-16 sm:py-24 bg-gray-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Quick Info Cards -->
      <div class="grid sm:grid-cols-2 gap-6 mb-12">
        <div class="bg-white rounded-2xl p-6 shadow-lg animate-on-scroll">
          <div class="text-electric mb-2">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-bold text-navy text-lg mb-1">Dates</h3>
          <p class="text-gray-600">Monday, August 17 through Thursday, August 20</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg animate-on-scroll stagger-2">
          <div class="text-electric mb-2">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-navy text-lg mb-1">Time</h3>
          <p class="text-gray-600">11am to 3pm each day</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg animate-on-scroll stagger-3">
          <div class="text-electric mb-2">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-bold text-navy text-lg mb-1">Location</h3>
          <p class="text-gray-600">Gantz Boys & Girls Club<br/>2915 N Leavitt St</p>
        </div>

        <div class="bg-white rounded-2xl p-6 shadow-lg animate-on-scroll stagger-4">
          <div class="text-electric mb-2">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
          </div>
          <h3 class="font-bold text-navy text-lg mb-1">What to Bring</h3>
          <p class="text-gray-600">Lunch & water<br/>(Snacks provided)</p>
        </div>
      </div>

      <!-- About the Camp -->
      <div class="bg-white rounded-2xl p-8 shadow-lg mb-8 animate-on-scroll">
        <h2 class="text-2xl font-bold text-navy mb-4">About the Summer Kickoff</h2>
        <p class="text-gray-600 mb-4">
          The summer camp is a key part of the season, when kids can set their team identities,
          research and investigate the project, and hopefully even solve their first robot mission.
        </p>
        <p class="text-gray-600">
          This is a great opportunity for new and returning team members to get a head start on
          the BIOGLOW challenge before regular practice begins.
        </p>
      </div>

      <!-- Registration -->
      <div class="bg-electric rounded-2xl p-8 shadow-lg text-white animate-on-scroll">
        <h2 class="text-2xl font-bold mb-4">Registration Required</h2>
        <p class="text-white/90 mb-6">
          The Boys & Girls Club generously offers us the use of their space. They request that
          each student fill out an application so they can report aggregate stats about the use
          of their space.
        </p>
        <a
          href="https://www.bgcc.org/join"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-white text-electric font-semibold px-6 py-3 rounded-xl transition-all hover:scale-105 shadow-lg"
        >
          Submit BGCC Application
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <!-- Volunteers -->
      <div class="mt-8 text-center animate-on-scroll">
        <p class="text-gray-600 mb-2">
          Want to help out at Summer Camp?
        </p>
        <a href="/volunteers/" class="text-electric hover:text-electric-dark font-semibold transition-colors">
          Learn about volunteering →
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
