---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Spring Classes" description="Intro and Advanced Robotics classes for students in grades 3-8">
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-24 bg-navy">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        Spring Classes
      </h1>
      <p class="text-xl text-white/80 animate-on-scroll">
        Robotics classes for students in grades 3-8
      </p>
    </div>
  </section>

  <section class="py-16 sm:py-24 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        <!-- Intro to Robotics -->
        <div class="bg-white rounded-2xl p-8 shadow-lg animate-on-scroll">
          <div class="inline-block bg-electric/10 text-electric font-semibold text-sm px-3 py-1 rounded-full mb-4">
            Mondays
          </div>
          <h2 class="text-2xl font-bold text-navy mb-2">Intro to Robotics</h2>
          <p class="text-gray-500 font-medium mb-4">Grades 3rd-5th</p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Learn the basics of building and programming robots using LEGO Spike Prime. Students will learn engineering and problem solving skills using robotics kits. Open to 3rd to 5th graders, including 4th graders who have already gone through FLL.
          </p>
          <p class="text-gray-600 italic mb-6">
            This is an excellent intro for students who may be interested in joining the FLL team next fall!
          </p>
          <a href="/classes/intro-to-robotics" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-semibold transition-colors">
            View schedule & details
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <!-- Advanced Robotics -->
        <div class="bg-white rounded-2xl p-8 shadow-lg animate-on-scroll">
          <div class="inline-block bg-electric/10 text-electric font-semibold text-sm px-3 py-1 rounded-full mb-4">
            Wednesdays
          </div>
          <h2 class="text-2xl font-bold text-navy mb-2">Advanced Robotics</h2>
          <p class="text-gray-500 font-medium mb-4">Grades 5th-7th</p>
          <p class="text-gray-700 leading-relaxed mb-4">
            Go beyond LEGO to learn more advanced programming and build techniques. Students will work in small groups using Python to solve challenges using robots. They will build from XRP kits, intended as a bridge to high-school level robotics. Open to 5th-8th graders, ideal for students who have already participated in an FLL team or have some coding experience.
          </p>
          <p class="text-gray-600 mb-6">
            You can see more information about XRP <a href="https://experientialrobotics.org/" target="_blank" rel="noopener noreferrer" class="text-electric hover:underline font-semibold">here</a>.
          </p>
          <a href="/classes/advanced-robotics" class="inline-flex items-center gap-2 text-electric hover:text-electric-dark font-semibold transition-colors">
            View schedule & details
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
