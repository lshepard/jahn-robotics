---
import BaseLayout from '../layouts/BaseLayout.astro';

// Official FIRST season materials live at:
// https://www.firstinspires.org/resources/library/fll/season-materials
const seasonMaterials = 'https://www.firstinspires.org/resources/library/fll/season-materials';
const blob = 'https://firstinspires.blob.core.windows.net/fll/challenge/2026-27';

const sections = [
  { id: 'rules', label: 'Rules & Missions' },
  { id: 'scoring', label: 'Scoring' },
  { id: 'judging', label: 'Judging Rubrics' },
  { id: 'resources', label: 'Resources' },
];
---

<BaseLayout
  title="BIOGLOW Season Resources"
  description="Rules, missions, rubrics, and scoresheets for the FIRST LEGO League BIOGLOW 2026-27 season"
>
  <!-- Hero -->
  <section class="relative pt-28 sm:pt-32 pb-16 sm:pb-20 overflow-hidden">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/fll/bioglow-background.png');"
    ></div>
    <div class="absolute inset-0 bg-navy/80"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block bg-green/20 text-green font-semibold text-sm px-4 py-1 rounded-full mb-4">
        2026-27 Season
      </span>
      <h1 class="text-4xl sm:text-5xl font-bold text-white mb-6 animate-on-scroll">
        BIOGLOW Season Resources
      </h1>
    </div>
  </section>

  <!-- Sticky section nav -->
  <nav class="sticky top-16 sm:top-20 z-30 bg-navy-light/95 backdrop-blur-md border-y border-white/10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex gap-1 overflow-x-auto py-2 -mx-1 px-1">
        {sections.map((s) => (
          <a
            href={`#${s.id}`}
            class="whitespace-nowrap px-3 py-2 rounded-lg text-sm font-medium text-white/70 hover:text-white hover:bg-white/10 transition-colors"
          >
            {s.label}
          </a>
        ))}
      </div>
    </div>
  </nav>

  <div class="bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 space-y-16 sm:space-y-20">

      <!-- RULES & MISSIONS -->
      <section id="rules" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">Rules &amp; Missions</h2>

        <div class="grid sm:grid-cols-2 gap-6">
          <a
            href={`${blob}/fll-challenge-bioglow-rgr.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll"
          >
            <img
              src="/images/bioglow/rulebook.jpg"
              alt="FIRST LEGO League Challenge Robot Game Rulebook cover"
              width="1200"
              height="630"
              loading="lazy"
              class="w-full aspect-[1200/630] object-cover border-b border-gray-100"
            />
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">PDF &middot; 20 pages</span>
              <h3 class="font-bold text-navy text-lg mt-1 group-hover:text-electric transition-colors">
                Robot Game Rulebook
              </h3>
            </div>
          </a>

          <a
            href={`${blob}/fll-challenge-bioglow-field-setup-reference-guide.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll stagger-2"
          >
            <img
              src="/images/bioglow/field-setup.jpg"
              alt="BIOGLOW Field Setup Guide cover"
              width="1200"
              height="630"
              loading="lazy"
              class="w-full aspect-[1200/630] object-cover border-b border-gray-100"
            />
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">PDF &middot; 17 pages</span>
              <h3 class="font-bold text-navy text-lg mt-1 group-hover:text-electric transition-colors">
                Field Setup Reference Guide
              </h3>
            </div>
          </a>
        </div>
      </section>

      <!-- SCORING -->
      <section id="scoring" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">Scoring</h2>
        <p class="text-gray-600 mb-8 max-w-2xl animate-on-scroll">
          Run the scoresheet after every practice round so the team can see their progress.
        </p>

        <div class="grid sm:grid-cols-2 gap-6">
          <a
            href={`${blob}/fll-challenge-bioglow-software-scoresheet.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll"
          >
            <img
              src="/images/bioglow/scoresheet.jpg"
              alt="BIOGLOW robot game scoresheet showing missions and scoring options"
              width="1200"
              height="630"
              loading="lazy"
              class="w-full aspect-[1200/630] object-cover object-top border-b border-gray-100"
            />
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">PDF &middot; Printable</span>
              <h3 class="font-bold text-navy text-lg mt-1 group-hover:text-electric transition-colors">
                Robot Game Scoresheet
              </h3>
            </div>
          </a>

          <a
            href="https://eventhub.firstinspires.org/scoresheet"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll stagger-2"
          >
            <img
              src="/images/bioglow/score-calculator.jpg"
              alt="FIRST Event Hub Official Scoring Calculator"
              width="1200"
              height="630"
              loading="lazy"
              class="w-full aspect-[1200/630] object-cover border-b border-gray-100"
            />
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">Web tool</span>
              <h3 class="font-bold text-navy text-lg mt-1 group-hover:text-electric transition-colors">
                Online Score Calculator
              </h3>
            </div>
          </a>
        </div>
      </section>

      <!-- JUDGING RUBRICS -->
      <section id="judging" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">Judging Rubrics</h2>
        
        <div class="grid sm:grid-cols-2 gap-6">
          <a
            href="/resources/bioglow/bioglow-innovation-project-rubric.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll"
          >
            <img
              src="/images/bioglow/rubric-innovation-project.jpg"
              alt="Innovation Project judging rubric with Beginning through Exceeds columns"
              width="1200"
              height="630"
              loading="lazy"
              class="w-full aspect-[1200/630] object-cover object-top border-b border-gray-100"
            />
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">PDF &middot; 1 page</span>
              <h3 class="font-bold text-navy text-lg mt-1 group-hover:text-electric transition-colors">
                Innovation Project Rubric
              </h3>
            </div>
          </a>

          <a
            href="/resources/bioglow/bioglow-robot-design-rubric.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll stagger-2"
          >
            <img
              src="/images/bioglow/rubric-robot-design.jpg"
              alt="Robot Design judging rubric with Beginning through Exceeds columns"
              width="1200"
              height="630"
              loading="lazy"
              class="w-full aspect-[1200/630] object-cover object-top border-b border-gray-100"
            />
            <div class="p-6">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-400">PDF &middot; 1 page</span>
              <h3 class="font-bold text-navy text-lg mt-1 group-hover:text-electric transition-colors">
                Robot Design Rubric
              </h3>
            </div>
          </a>
        </div>
      </section>

      <!-- RESOURCES -->
      <section id="resources" class="scroll-mt-40">
        <h2 class="text-3xl font-bold text-navy mb-3 animate-on-scroll">Resources</h2>

        <div class="grid sm:grid-cols-2 gap-6">
          <a
            href={seasonMaterials}
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-navy rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll"
          >
            <h3 class="font-bold text-white text-lg mb-1">FIRST Season Materials</h3>
            <p class="text-white/70 text-sm mb-3">
              The complete official BIOGLOW library — rulebook, engineering notebook, building
              instructions, judging materials, and challenge updates.
            </p>
            <span class="text-electric font-semibold text-sm">Open on firstinspires.org →</span>
          </a>

          <a
            href="https://flltutorials.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="group bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition-all hover:-translate-y-1 animate-on-scroll stagger-2"
          >
            <h3 class="font-bold text-navy text-lg mb-1 group-hover:text-electric transition-colors">FLLTutorials</h3>
            <p class="text-gray-600 text-sm mb-3">
              Free tutorials and printable worksheets for mission strategy, robot design, the
              innovation project, and Core Values.
            </p>
            <span class="text-electric font-semibold text-sm">Open flltutorials.com →</span>
          </a>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
