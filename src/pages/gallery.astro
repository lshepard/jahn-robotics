---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Gallery" description="Photos and moments from the Jahn Robotics teams.">
  <!-- Header -->
  <section class="bg-navy pt-28 sm:pt-32 pb-16 sm:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 animate-on-scroll">
        Gallery
      </h1>
      <p class="text-lg sm:text-xl text-white/70 max-w-2xl mx-auto animate-on-scroll">
        Moments from competitions, practice sessions, and team celebrations.
      </p>
    </div>
  </section>

  <!-- Gallery placeholder -->
  <section class="py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-gray-50 rounded-2xl p-12 border-2 border-dashed border-gray-200 animate-on-scroll">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
        </svg>
        <h2 class="text-xl font-bold text-gray-900 mb-2">Photos Coming Soon</h2>
        <p class="text-gray-500">
          We're gathering photos from this season's competitions and events. Check back soon for a full gallery of team moments!
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
